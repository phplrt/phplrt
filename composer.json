{
    "name": "phplrt/phplrt",
    "type": "library",
    "description": "PHP Language Recognition Tool",
    "homepage": "https://phplrt.org",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/phplrt/phplrt/issues",
        "source": "https://github.com/phplrt/phplrt"
    },
    "authors": [
        {
            "name": "Kirill Nesmeyanov",
            "email": "nesk@xakep.ru"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pcre": "*",
        "ext-spl": "*",
        "symfony/deprecation-contracts": "^2.5|^3.0",
        "laminas/laminas-code": "^4.17"
    },
    "autoload": {
        "psr-4": {
            "Phplrt\\Buffer\\": "libs.old/buffer/src",
            "Phplrt\\Compiler\\": "libs.old/compiler/src",
            "Phplrt\\Compiler\\Lexer\\": "libs/components/lexer-compiler/src",
            "Phplrt\\Contracts\\Ast\\": "libs.old/contracts/ast/src",
            "Phplrt\\Contracts\\Exception\\": "libs.old/contracts/exception/src",
            "Phplrt\\Contracts\\Lexer\\": "libs/contracts/lexer/src",
            "Phplrt\\Contracts\\Parser\\": "libs.old/contracts/parser/src",
            "Phplrt\\Contracts\\Position\\": "libs/contracts/position/src",
            "Phplrt\\Contracts\\Source\\": "libs/contracts/source/src",
            "Phplrt\\Exception\\": "libs.old/exception/src",
            "Phplrt\\Parser\\": "libs.old/parser/src",
            "Phplrt\\Position\\": "libs.old/position/src",
            "Phplrt\\Source\\": "libs/components/source/src",
            "Phplrt\\Visitor\\": "libs.old/visitor/src"
        },
        "files": [
            "libs.old/parser/src/polyfill.php"
        ]
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "httpsoft/http-message": "^1.1",
        "jetbrains/phpstorm-attributes": "^1.0",
        "phpstan/phpdoc-parser": "^2.3",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5|^13.0",
        "psr/http-message": "^1.0|^2.0",
        "symfony/var-dumper": "^6.4|^7.0|^8.0",
        "symplify/monorepo-builder": "^12.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Phplrt\\Buffer\\Tests\\": "libs.old/buffer/tests",
            "Phplrt\\Compiler\\Tests\\": "libs.old/compiler/tests",
            "Phplrt\\Compiler\\Lexer\\Tests\\": "libs/components/lexer-compiler/tests",
            "Phplrt\\Contracts\\Ast\\Tests\\": "libs.old/contracts/ast/tests",
            "Phplrt\\Contracts\\Exception\\Tests\\": "libs.old/contracts/exception/tests",
            "Phplrt\\Contracts\\Lexer\\Tests\\": "libs/contracts/lexer/tests",
            "Phplrt\\Contracts\\Parser\\Tests\\": "libs.old/contracts/parser/tests",
            "Phplrt\\Contracts\\Position\\Tests\\": "libs/contracts/position/tests",
            "Phplrt\\Contracts\\Source\\Tests\\": "libs/contracts/source/tests",
            "Phplrt\\Exception\\Tests\\": "libs.old/exception/tests",
            "Phplrt\\Parser\\Tests\\": "libs.old/parser/tests",
            "Phplrt\\Position\\Tests\\": "libs.old/position/tests",
            "Phplrt\\Source\\Tests\\": "libs/components/source/tests",
            "Phplrt\\Visitor\\Tests\\": "libs.old/visitor/tests"
        }
    },
    "replace": {
        "phplrt/ast-contracts": "*",
        "phplrt/buffer": "*",
        "phplrt/compiler": "*",
        "phplrt/contracts": "*",
        "phplrt/exception": "*",
        "phplrt/exception-contracts": "*",
        "phplrt/grammar": "*",
        "phplrt/grammar-contracts": "*",
        "phplrt/lexer": "*",
        "phplrt/lexer-compiler": "*",
        "phplrt/lexer-contracts": "*",
        "phplrt/parser": "*",
        "phplrt/parser-contracts": "*",
        "phplrt/position": "*",
        "phplrt/position-contracts": "*",
        "phplrt/runtime": "*",
        "phplrt/source": "*",
        "phplrt/source-contracts": "*",
        "phplrt/visitor": "*"
    },
    "provide": {
        "phplrt/exception-contracts-implementation": "^4.0",
        "phplrt/lexer-contracts-implementation": "^4.0",
        "phplrt/parser-contracts-implementation": "^4.0",
        "phplrt/position-contracts-implementation": "^4.0",
        "phplrt/source-contracts-implementation": "^4.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts-aliases": {
        "test:unit": ["test", "phpunit", "unit"],
        "linter:check": ["linter", "stan"],
        "phpcs:fix": ["phpcs", "cs", "psr", "per"]
    },
    "scripts": {
        "test:unit": "phpunit --testdox",
        "linter:check": "phpstan analyse --configuration phpstan.neon --memory-limit 256M",
        "linter:baseline": "@linter:check --generate-baseline",
        "phpcs:check": "@phpcs:fix --dry-run",
        "phpcs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes --verbose --diff",
        "dev:merge": "monorepo-builder merge"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
