{
    "name": "phplrt/phplrt",
    "type": "library",
    "description": "PHP Language Recognition Tool",
    "homepage": "https://phplrt.org",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/phplrt/phplrt/issues",
        "source": "https://github.com/phplrt/phplrt"
    },
    "authors": [
        {
            "name": "Kirill Nesmeyanov",
            "email": "nesk@xakep.ru"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pcre": "*",
        "ext-spl": "*",
        "laminas/laminas-code": "^4.17",
        "symfony/deprecation-contracts": "^2.5|^3.0",
        "twig/twig": "^3.23"
    },
    "autoload": {
        "psr-4": {
            "Phplrt\\Compiler\\Lexer\\": "libs/components/lexer-compiler/src",
            "Phplrt\\Contracts\\Lexer\\": "libs/contracts/lexer/src",
            "Phplrt\\Contracts\\Parser\\": "libs/contracts/parser/src",
            "Phplrt\\Contracts\\Source\\": "libs/contracts/source/src",
            "Phplrt\\Lexer\\": "libs/components/lexer/src",
            "Phplrt\\Parser\\": "libs/components/parser/src",
            "Phplrt\\Source\\": "libs/components/source/src"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "httpsoft/http-message": "^1.1",
        "jetbrains/phpstorm-attributes": "^1.0",
        "phpbench/phpbench": "^1.4",
        "phpstan/phpdoc-parser": "^2.3",
        "phpstan/phpstan": "^2.1.38",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5|^13.0",
        "psr/http-message": "^1.0|^2.0",
        "symfony/var-dumper": "^6.4|^7.0|^8.0",
        "symplify/monorepo-builder": "^12.5.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Phplrt\\Compiler\\Lexer\\Tests\\": "libs/components/lexer-compiler/tests",
            "Phplrt\\Contracts\\Lexer\\Tests\\": "libs/contracts/lexer/tests",
            "Phplrt\\Contracts\\Parser\\Tests\\": "libs/contracts/parser/tests",
            "Phplrt\\Contracts\\Source\\Tests\\": "libs/contracts/source/tests",
            "Phplrt\\Lexer\\Tests\\": "libs/components/lexer/tests",
            "Phplrt\\Parser\\Tests\\": "libs/components/parser/tests",
            "Phplrt\\Source\\Tests\\": "libs/components/source/tests",
            "Phplrt\\Tests\\": "tests"
        }
    },
    "replace": {
        "phplrt/lexer": "*",
        "phplrt/lexer-compiler": "*",
        "phplrt/lexer-contracts": "*",
        "phplrt/parser-contracts": "*",
        "phplrt/position-contracts": "*",
        "phplrt/runtime": "*",
        "phplrt/source": "*",
        "phplrt/source-contracts": "*",
        "phplrt/parser": "self.version"
    },
    "provide": {
        "phplrt/lexer-contracts-implementation": "^4.0",
        "phplrt/parser-contracts-implementation": "^4.0",
        "phplrt/source-contracts-implementation": "^4.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts-aliases": {
        "test:unit": [
            "test",
            "phpunit",
            "unit"
        ],
        "linter:check": [
            "linter",
            "stan"
        ],
        "phpcs:fix": [
            "phpcs",
            "cs",
            "psr",
            "per"
        ]
    },
    "scripts": {
        "test:unit": "phpunit --testdox",
        "linter:check": "phpstan analyse --configuration phpstan.neon --memory-limit 256M",
        "linter:baseline": "@linter:check --generate-baseline",
        "phpcs:check": "@phpcs:fix --dry-run",
        "phpcs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes --verbose --diff",
        "dev:merge": "monorepo-builder merge",
        "bench:lexer:capture": "@bench:compare --filter=benchLexicalAnalysis --tag=original",
        "bench:lexer:diff": "@bench:compare --filter=benchLexicalAnalysis --ref=original",
        "bench:lexer": "phpbench run --filter=benchLexicalAnalysis --report=default",
        "bench:compare": "phpbench run --report=aggregate"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
