{
    "name": "phplrt/phplrt",
    "type": "library",
    "description": "PHP Language Recognition Tool",
    "homepage": "https://phplrt.org",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/phplrt/phplrt/issues",
        "source": "https://github.com/phplrt/phplrt"
    },
    "authors": [
        {
            "name": "Kirill Nesmeyanov",
            "email": "nesk@xakep.ru"
        }
    ],
    "bin": [
        "libs/components/compiler/bin/phplrt"
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-pcre": "*",
        "composer-runtime-api": "^2.0",
        "psr/log": "^3.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "twig/twig": "^3.28"
    },
    "autoload": {
        "psr-4": {
            "Phplrt\\Compiler\\": "libs/components/compiler/src",
            "Phplrt\\Contracts\\Lexer\\": "libs/contracts/lexer/src",
            "Phplrt\\Contracts\\Parser\\": "libs/contracts/parser/src",
            "Phplrt\\Contracts\\Position\\": [
                "libs/contracts/position/src",
                "libs/contracts/position-factory/src"
            ],
            "Phplrt\\Contracts\\Source\\": [
                "libs/contracts/source/src",
                "libs/contracts/source-factory/src"
            ],
            "Phplrt\\Exception\\": "libs/components/exception/src",
            "Phplrt\\Lexer\\": "libs/components/lexer/src",
            "Phplrt\\Lexer\\Builder\\": "libs/components/lexer-builder/src",
            "Phplrt\\Parser\\": "libs/components/parser/src",
            "Phplrt\\Parser\\Builder\\": "libs/components/parser-builder/src",
            "Phplrt\\Position\\": "libs/components/position/src",
            "Phplrt\\Source\\": "libs/components/source/src"
        },
        "files": [
            "libs/components/source/src/polyfill.php"
        ]
    },
    "require-dev": {
        "ext-intl": "*",
        "ext-mbstring": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "symfony/var-dumper": "^6.4|^7.0|^8.0",
        "testo/testo": "^0.10.45"
    },
    "autoload-dev": {
        "psr-4": {
            "Phplrt\\Compiler\\Tests\\": "libs/components/compiler/tests",
            "Phplrt\\Contracts\\Lexer\\Tests\\": "libs/contracts/lexer/tests",
            "Phplrt\\Contracts\\Parser\\Tests\\": "libs/contracts/parser/tests",
            "Phplrt\\Contracts\\Position\\Tests\\": "libs/contracts/position/tests",
            "Phplrt\\Contracts\\Position\\Tests\\Factory\\": "libs/contracts/position-factory/tests",
            "Phplrt\\Contracts\\Source\\Tests\\": "libs/contracts/source/tests",
            "Phplrt\\Contracts\\Source\\Tests\\Factory\\": "libs/contracts/source-factory/tests",
            "Phplrt\\Exception\\Tests\\": "libs/components/exception/tests",
            "Phplrt\\Lexer\\Builder\\Tests\\": "libs/components/lexer-builder/tests",
            "Phplrt\\Lexer\\Tests\\": "libs/components/lexer/tests",
            "Phplrt\\Parser\\Builder\\Tests\\": "libs/components/parser-builder/tests",
            "Phplrt\\Parser\\Tests\\": "libs/components/parser/tests",
            "Phplrt\\Position\\Tests\\": "libs/components/position/tests",
            "Phplrt\\Source\\Tests\\": "libs/components/source/tests"
        }
    },
    "replace": {
        "phplrt/compiler": "*",
        "phplrt/exception": "*",
        "phplrt/lexer": "*",
        "phplrt/lexer-builder": "*",
        "phplrt/lexer-contracts": "*",
        "phplrt/parser": "*",
        "phplrt/parser-builder": "*",
        "phplrt/parser-contracts": "*",
        "phplrt/position": "*",
        "phplrt/position-contracts": "*",
        "phplrt/position-factory-contracts": "*",
        "phplrt/runtime": "*",
        "phplrt/source": "*",
        "phplrt/source-contracts": "*",
        "phplrt/source-factory-contracts": "*"
    },
    "provide": {
        "phplrt/lexer-contracts-implementation": "^4.0",
        "phplrt/parser-contracts-implementation": "^4.0",
        "phplrt/position-contracts-implementation": "^4.0",
        "phplrt/position-factory-contracts-implementation": "^4.0",
        "phplrt/source-contracts-implementation": "^4.0",
        "phplrt/source-factory-contracts-implementation": "^4.0"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts-aliases": {
        "test:unit": [
            "test",
            "testo",
            "unit"
        ],
        "linter:check": [
            "linter",
            "stan"
        ],
        "phpcs:fix": [
            "phpcs",
            "cs",
            "psr",
            "per"
        ]
    },
    "scripts": {
        "test:unit": "testo",
        "linter:check": "phpstan analyse --configuration phpstan.neon --memory-limit 256M",
        "linter:baseline": "@linter:check --generate-baseline",
        "phpcs:check": "@phpcs:fix --dry-run",
        "phpcs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes --verbose --diff",
        "dev:merge": "monorepo-builder merge",
        "dev:syntax": "php libs/components/compiler/bin/build.php"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
