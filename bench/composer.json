{
    "name": "phplrt/benchmarks",
    "description": "A phplrt benchmarks compared to various tools",
    "version": "4.0.0",
    "type": "project",
    "license": "MIT",
    "keywords": ["benchmark", "comparison"],
    "homepage": "https://github.com/phplrt",
    "authors": [
        {
            "name": "Kirill Nesmeyanov",
            "email": "nesk@xakep.ru"
        }
    ],
    "support": {
        "issues": "https://github.com/phplrt/phplrt/issues",
        "source": "https://github.com/phplrt/benchmarks"
    },
    "require": {
        "php": "^8.4",
        "symfony/process": "^8.1",
        "phpbench/phpbench": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "Phplrt\\Bench\\": "src"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev",
            "dev-main": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
