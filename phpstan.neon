includes:
  - phar://phpstan.phar/conf/bleedingEdge.neon
  - vendor/phpstan/phpstan-strict-rules/rules.neon
  - phpstan-baseline.neon
  # Contracts
  - libs/contracts/lexer/phpstan.neon
  # Legacy Components
  - libs.old/contracts/ast/phpstan.neon
  - libs.old/contracts/exception/phpstan.neon
  - libs.old/contracts/parser/phpstan.neon
  - libs.old/contracts/position/phpstan.neon
  - libs.old/contracts/source/phpstan.neon
  - libs.old/buffer/phpstan.neon
  - libs.old/compiler/phpstan.neon
  - libs.old/exception/phpstan.neon
  - libs.old/lexer/phpstan.neon
  - libs.old/parser/phpstan.neon
  - libs.old/position/phpstan.neon
  - libs.old/source/phpstan.neon
  - libs.old/visitor/phpstan.neon
parameters:
  level: max
  strictRules:
    allRules: true
  fileExtensions:
    - php
  tmpDir: vendor/.cache.phpstan
  reportUnmatchedIgnoredErrors: false
