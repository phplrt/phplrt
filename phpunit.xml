<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         backupGlobals="true"
         bootstrap="vendor/autoload.php"
         cacheDirectory="vendor/.cache.phpunit"
>
    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="memory_limit" value="-1"/>
    </php>

    <testsuites>
        <testsuite name="contracts">
            <directory>libs/contracts/*/tests</directory>
            <directory>libs/components/*/tests</directory>
        </testsuite>
    </testsuites>

    <coverage/>

    <source>
        <include>
            <directory suffix=".php">libs/**/src</directory>
            <!--
            <directory suffix=".php">libs.old/*/src</directory>
            <directory suffix=".php">libs.old/contracts/*/src</directory>
            -->
        </include>
    </source>
</phpunit>
