{
    "name": "phplrt/source-factory-contracts",
    "type": "library",
    "description": "A set of phplrt source factory abstractions",
    "license": "MIT",
    "keywords": ["file", "source", "io", "disk", "read", "factory"],
    "homepage": "https://github.com/phplrt",
    "support": {
        "issues": "https://github.com/phplrt/phplrt/issues",
        "source": "https://github.com/phplrt/source-factory-contracts"
    },
    "authors": [
        {
            "name": "Kirill Nesmeyanov",
            "email": "nesk@xakep.ru"
        }
    ],
    "require": {
        "php": "^8.4",
        "phplrt/source-contracts": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Phplrt\\Contracts\\Source\\": "src"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "phpstan/phpstan": "^2.2"
    },
    "autoload-dev": {
        "psr-4": {
            "Phplrt\\Contracts\\Source\\Tests\\Factory\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev",
            "dev-main": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
