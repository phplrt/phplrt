{
    "name": "phplrt/lexer-contracts",
    "type": "library",
    "description": "A set of phplrt lexer abstractions",
    "license": "MIT",
    "keywords": ["abstractions", "contracts", "decoupling", "interfaces", "interoperability", "standards", "regex", "lexer", "token", "stream", "parsing", "tokenizer"],
    "homepage": "https://github.com/phplrt",
    "support": {
        "issues": "https://github.com/phplrt/phplrt/issues",
        "source": "https://github.com/phplrt/lexer-contracts"
    },
    "authors": [
        {
            "name": "Kirill Nesmeyanov",
            "email": "nesk@xakep.ru"
        }
    ],
    "require": {
        "php": "^8.1",
        "phplrt/source-contracts": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Phplrt\\Contracts\\Lexer\\": "src"
        }
    },
    "require-dev": {
        "testo/testo": "^0.10.45",
        "phpstan/phpstan": "^2.2"
    },
    "autoload-dev": {
        "psr-4": {
            "Phplrt\\Contracts\\Lexer\\Tests\\": "tests"
        }
    },
    "suggest": {
        "llm/skills": "Delivers the bundled phplrt agent skill (a lexer/parser authoring guide) into your AI coding assistant"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev",
            "dev-main": "4.x-dev"
        },
        "skills": {
            "sources": [
                {
                    "from": "github",
                    "package": "phplrt/phplrt",
                    "ref": "self.version"
                }
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
