{
    "name": "phplrt/runtime",
    "type": "metapackage",
    "description": "A set of phplrt runtime libraries",
    "license": "MIT",
    "keywords": ["runtime"],
    "homepage": "https://github.com/phplrt",
    "support": {
        "issues": "https://github.com/phplrt/phplrt/issues",
        "source": "https://github.com/phplrt/runtime"
    },
    "authors": [
        {
            "name": "Kirill Nesmeyanov",
            "email": "nesk@xakep.ru"
        }
    ],
    "require": {
        "php": "^8.1",
        "phplrt/lexer": "^4.1",
        "phplrt/parser": "^4.1",
        "phplrt/source": "^4.1"
    },
    "suggest": {
        "llm/skills": "Delivers the bundled phplrt agent skill (a lexer/parser authoring guide) into your AI coding assistant"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev",
            "dev-main": "4.x-dev"
        },
        "skills": {
            "sources": [
                {
                    "from": "github",
                    "package": "phplrt/phplrt",
                    "ref": "self.version"
                }
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
