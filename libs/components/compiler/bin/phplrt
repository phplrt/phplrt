#!/usr/bin/env php
<?php

declare(strict_types=1);

use Phplrt\Compiler\Command\GrammarCheckCommand;
use Phplrt\Compiler\Command\GrammarCompileCommand;
use Phplrt\Compiler\Compiler;
use Symfony\Component\Console\Application;

require __DIR__ . '/bootstrap.php';

$app = new Application('phplrt', Compiler::getVersion());

// Note: The method a single command is registered by has been renamed in
//       symfony/console 7.4, while this one is spelled the same in every
//       version the compiler is built against
$app->addCommands([
    new GrammarCompileCommand(),
    new GrammarCheckCommand(),
]);

exit($app->run());
