lexer: {{ include('lexer.php.twig', {lexer: lexer, name: null, path: ''})|trim }},
grammar: {{ include('parser/grammar.php.twig')|trim }},
initial: {{ parser.initial }},
{% if parser.reducers is not empty %}
reducers: {{ include('parser/reducers.php.twig')|trim }},
{% endif %}
{% if parser.lookahead is not empty %}
lookahead: {{ value(parser.lookahead) }},
{% endif %}
{% if parser.presentInTree is not empty %}
presentInTree: {{ value(parser.presentInTree) }},
{% endif %}
{% if parser.branchesByToken is not empty %}
branchesByToken: {{ value(parser.branchesByToken) }},
{% endif %}
