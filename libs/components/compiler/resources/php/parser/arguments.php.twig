lexer: $this->lexer,
grammar: {{ include('parser/grammar.php.twig')|trim }},
initial: {{ parser.initial }},
{% if parser.reducers is not empty %}
reducers: {{ include('parser/reducers.php.twig')|trim }},
{% endif %}
{% if parser.expectations is not empty %}
expectations: self::PARSER_EXPECTATIONS,
{% endif %}
{% if parser.messages is not empty %}
messages: self::PARSER_MESSAGES,
{% endif %}
{% if parser.kept is not empty %}
kept: self::PARSER_KEPT_TABLE,
{% endif %}
{% if parser.startPrediction is not empty %}
startPrediction: self::PARSER_START_PREDICTION_TABLE,
{% endif %}
{% if parser.choicePrediction is not empty %}
choicePrediction: self::PARSER_CHOICE_PREDICTION_TABLE,
{% endif %}
{% if parser.sequencePrediction is not empty %}
sequencePrediction: self::PARSER_SEQUENCE_PREDICTION_TABLE,
{% endif %}
