/**
 * -----------------------------------------------------------------------------
 *  The PP3 Grammar Format, Written In PP3
 * -----------------------------------------------------------------------------
 *
 *  Run "composer dev:syntax" after changing anything here: the parser is
 *  generated into "src/Syntax/PP3/PP3Parser.php" and is committed along with
 *  this file.
 */

%include grammar/pp3/lexemes        // The tokens this format reads
%include grammar/pp3/directives     // %pragma, %include
%include grammar/pp3/declarations   // %token, %lexer, a rule of the parser
%include grammar/pp3/reducers       // -> { ... }
%include grammar/pp3/statements     // What a rule recognizes
%include grammar/pp3/quantifiers    // How many times a statement repeats

%pragma root Grammar

Grammar : Declaration()* ;
