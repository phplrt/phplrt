/**
 * -----------------------------------------------------------------------------
 *  Declarations Of The PP3 Format
 * -----------------------------------------------------------------------------
 */

Declaration
  : TokenDeclaration()
  | FragmentDeclaration()
  | PragmaDeclaration()
  | IncludeDeclaration()
  | LexerDeclaration()
  | RuleDeclaration()
  ;

/**
 * A token to read, like:
 *  - %token string:T_QUOTE " -> state(string), channel(strings)
 *  - %skip *:T_WHITESPACE \s++
 */
TokenDeclaration -> {
    \assert($children instanceof \Phplrt\Lexer\Token\TokenEmbedding);

    $state = null;
    $name = null;
    $pattern = null;
    $actions = [];

    foreach ($children->children as $part) {
        // A declaration is written of each part at most once, so anything
        // written twice is pointed at where it is written
        switch ($part->name) {
            case 'T_STATE':
                if ($state !== null) {
                    throw \Phplrt\Parser\Exception\UnexpectedTokenException::becauseUnexpectedTokenProduced($ctx->source, $part);
                }

                $state = \substr($part->value, 0, -1);

                break;

            case 'T_NAME':
                if ($name !== null) {
                    throw \Phplrt\Parser\Exception\UnexpectedTokenException::becauseUnexpectedTokenProduced($ctx->source, $part);
                }

                $name = $part->value;

                break;

            case 'T_PATTERN':
                if ($pattern !== null) {
                    throw \Phplrt\Parser\Exception\UnexpectedTokenException::becauseUnexpectedTokenProduced($ctx->source, $part);
                }

                $pattern = $part->value;

                break;

            case 'T_ACTIONS':
                if ($actions !== []) {
                    throw \Phplrt\Parser\Exception\UnexpectedTokenException::becauseUnexpectedTokenProduced($ctx->source, $part);
                }

                \preg_match_all(
                    pattern: '/([a-zA-Z_][a-zA-Z0-9_]*+)\h*+\(\h*+([a-zA-Z_][a-zA-Z0-9_]*+)?\h*+\)/',
                    subject: $part->value,
                    matches: $matches,
                    flags: \PREG_SET_ORDER | \PREG_OFFSET_CAPTURE,
                );

                foreach ($matches as $match) {
                    [$action, $at] = $match[0];

                    $argument = $match[2][0] ?? '';

                    $actions[] = new \Phplrt\Compiler\Node\Declaration\TokenAction(
                        name: $match[1][0],
                        argument: $argument === '' ? null : $argument,
                        offset: \max(0, $part->offset + $at),
                        length: \strlen($action),
                    );
                }

                break;
        }
    }

    // A declaration written of anything but a name and an expression describes
    // no token at all
    if ($name === null || $name === '' || $pattern === null || $pattern === '') {
        throw \Phplrt\Parser\Exception\UnexpectedTokenException::becauseUnexpectedTokenProduced($ctx->source, $children);
    }

    return new \Phplrt\Compiler\Node\Declaration\TokenDeclaration(
        name: $name,
        pattern: $pattern,
        state: $state === '' ? null : $state,
        isHidden: $children->value === '%skip',
        actions: $actions,
        offset: $children->offset,
        length: $children->size,
    );
}
  : <T_TOKEN>
  | <T_SKIP>
  ;

/**
 * A named piece of an expression, like:
 *  - %fragment DIGIT [0-9]
 */
FragmentDeclaration -> {
    \assert($children instanceof \Phplrt\Lexer\Token\TokenEmbedding);

    $name = null;
    $pattern = null;

    foreach ($children->children as $part) {
        switch ($part->name) {
            case 'T_NAME':
                if ($name !== null) {
                    throw \Phplrt\Parser\Exception\UnexpectedTokenException::becauseUnexpectedTokenProduced($ctx->source, $part);
                }

                $name = $part->value;

                break;

            case 'T_PATTERN':
                if ($pattern !== null) {
                    throw \Phplrt\Parser\Exception\UnexpectedTokenException::becauseUnexpectedTokenProduced($ctx->source, $part);
                }

                $pattern = $part->value;

                break;

            case 'T_STATE':
            case 'T_ACTIONS':
                throw \Phplrt\Parser\Exception\UnexpectedTokenException::becauseUnexpectedTokenProduced($ctx->source, $part);
        }
    }

    // A declaration written of anything but a name and an expression describes
    // no piece at all
    if ($name === null || $name === '' || $pattern === null || $pattern === '') {
        throw \Phplrt\Parser\Exception\UnexpectedTokenException::becauseUnexpectedTokenProduced($ctx->source, $children);
    }

    return new \Phplrt\Compiler\Node\Declaration\FragmentDeclaration(
        name: $name,
        pattern: $pattern,
        offset: $children->offset,
        length: $children->size,
    );
}
  : <T_FRAGMENT>
  ;

/**
 * A lexer written by hand, like:
 *  - %lexer php -> { new \App\Lexer\PhpLexer() }
 */
LexerDeclaration -> {
    \assert(\is_array($children));

    $declaration = $children[0] ?? null;
    $lexer = $children[1] ?? null;

    \assert($declaration instanceof \Phplrt\Lexer\Token\Token);
    \assert($lexer instanceof \Phplrt\Compiler\Node\Reducer\CodeReducer);

    $name = $declaration->captures[0] ?? '';

    if ($name === '') {
        throw \Phplrt\Parser\Exception\UnexpectedTokenException::becauseUnexpectedTokenProduced($ctx->source, $declaration);
    }

    return new \Phplrt\Compiler\Node\Declaration\LexerDeclaration(
        name: $name,
        lexer: $lexer,
        offset: $declaration->offset,
        length: \max(0, $lexer->offset + $lexer->length - $declaration->offset),
    );
}
  : <T_LEXER> CodeReducer()
  ;

/**
 * A rule of the parser, like:
 *  - Sum -> { return new SumNode($children); } : Number() ;
 *  - #Sum @error("a sum is expected") : Number() ;
 */
RuleDeclaration -> {
    \assert(\is_array($children));

    $isKept = ($children[0] ?? null) === true;

    if ($isKept) {
        \array_shift($children);
    }

    $name = \array_shift($children);
    $body = \array_pop($children);

    $annotations = [];

    // What is said about the rule is written after its name, so it is read off
    // the front until the reducer is reached
    while (($annotation = $children[0] ?? null) instanceof \Phplrt\Compiler\Node\Annotation) {
        $annotations[] = $annotation;

        \array_shift($children);
    }

    $reducer = \array_pop($children);

    \assert($name instanceof \Phplrt\Contracts\Lexer\TokenInterface);
    \assert($name->value !== '', 'The lexer never produces an empty token');
    \assert($body instanceof \Phplrt\Compiler\Node\Statement\Statement);
    \assert($reducer === null || $reducer instanceof \Phplrt\Compiler\Node\Reducer\Reducer);

    return new \Phplrt\Compiler\Node\Declaration\RuleDeclaration(
        name: $name->value,
        body: $body,
        reducer: $reducer,
        isKept: $isKept,
        annotations: $annotations,
        offset: $name->offset,
        length: \max(0, $body->offset + $body->length - $name->offset),
    );
}
  : KeptMarker()? <T_NAME> AnnotationList()? CodeReducer()? ::T_COLON:: Alternation() ::T_SEMICOLON::?
  ;

KeptMarker -> { return true; } : <T_HASH> ;
