/**
 * -----------------------------------------------------------------------------
 *  Statements Of The PP3 Format
 * -----------------------------------------------------------------------------
 *
 *  What a rule of the parser recognizes: the alternatives it is written of,
 *  each of them a sequence of statements. A statement may be written with a
 *  predicate before it.
 *
 *  What may be written before a statement in this format (a predicate) and the
 *  two ways a rule declares a token on the spot.
 *
 */

/**
 * One of several things to recognize, like:
 *  - Number() | Name()
 *
 *  An alternative of a single statement is that statement: the choice a rule
 *  is written of is only a choice once there is something to choose from.
 */
Alternation -> {
    \assert(\is_array($children));

    $statements = [];

    foreach ($children as $statement) {
        \assert($statement instanceof \Phplrt\Compiler\Node\Statement\Statement);

        $statements[] = $statement;
    }

    \assert($statements !== [], 'A production recognizes at least one statement');

    if (!isset($statements[1])) {
        return $statements[0];
    }

    $last = $statements[\count($statements) - 1];

    return new \Phplrt\Compiler\Node\Statement\Alternation(
        statements: $statements,
        offset: $statements[0]->offset,
        length: \max(0, $last->offset + $last->length - $statements[0]->offset),
    );
}
  : Concatenation() AlternationTail()*
  ;

AlternationTail : ::T_OR:: Concatenation() ;

/**
 * Several things to recognize one after another, like:
 *  - Number() ::T_PLUS:: Number()
 *
 *  A sequence of a single statement is that statement, for the very same
 *  reason an alternative of one is.
 */
Concatenation -> {
    \assert(\is_array($children));

    $statements = [];

    foreach ($children as $statement) {
        \assert($statement instanceof \Phplrt\Compiler\Node\Statement\Statement);

        $statements[] = $statement;
    }

    \assert($statements !== [], 'A production recognizes at least one statement');

    if (!isset($statements[1])) {
        return $statements[0];
    }

    $last = $statements[\count($statements) - 1];

    return new \Phplrt\Compiler\Node\Statement\Concatenation(
        statements: $statements,
        offset: $statements[0]->offset,
        length: \max(0, $last->offset + $last->length - $statements[0]->offset),
    );
}
  : Element()+
  ;

/**
 * A statement along with the number of times it may repeat, like:
 *  - Number()*
 *
 *  A statement written with no quantifier repeats exactly once, which is what
 *  the statement itself already means.
 */
Suffixed -> {
    \assert(\is_array($children));

    $statement = $children[0] ?? null;
    $quantifier = $children[1] ?? null;

    \assert($statement instanceof \Phplrt\Compiler\Node\Statement\Statement);

    if (!$quantifier instanceof \Phplrt\Compiler\Node\Statement\Quantifier) {
        return $statement;
    }

    return new \Phplrt\Compiler\Node\Statement\Repetition(
        statement: $statement,
        quantifier: $quantifier,
        offset: $statement->offset,
        length: \max(0, $quantifier->offset + $quantifier->length - $statement->offset),
    );
}
  : Primary() Quantifier()?
  ;

/**
 * A token a rule declares on the spot is spelled differently by each format,
 * so "Inline" is what a format defines on its own.
 */
Primary
  : Group()
  | KeptTokenReference()
  | SkippedTokenReference()
  | RuleReference()
  | Inline()
  ;

/**
 * A statement written apart from the ones surrounding it, like:
 *  - ( Number() | Name() )
 *
 *  The brackets say nothing of their own: they only decide what belongs to
 *  what, which the statement written between them already records.
 */
Group : ::T_PARENTHESIS_OPEN:: Alternation() ::T_PARENTHESIS_CLOSE:: ;

/**
 * A token whose value is kept in the syntax tree, like:
 *  - <T_NAME>
 */
KeptTokenReference -> {
    \assert(\is_array($children));

    $name = $children[0] ?? null;

    \assert($name instanceof \Phplrt\Contracts\Lexer\TokenInterface);
    \assert($name->value !== '', 'The lexer never produces an empty token');

    return new \Phplrt\Compiler\Node\Statement\TokenReference(
        name: $name->value,
        isKept: true,
        offset: $name->offset,
        length: $name->size,
    );
}
  : ::T_ANGLE_OPEN:: <T_NAME> ::T_ANGLE_CLOSE::
  ;

/**
 * A token that is read and thrown away, like:
 *  - ::T_COMMA::
 */
SkippedTokenReference -> {
    \assert(\is_array($children));

    $name = $children[0] ?? null;

    \assert($name instanceof \Phplrt\Contracts\Lexer\TokenInterface);
    \assert($name->value !== '', 'The lexer never produces an empty token');

    return new \Phplrt\Compiler\Node\Statement\TokenReference(
        name: $name->value,
        isKept: false,
        offset: $name->offset,
        length: $name->size,
    );
}
  : ::T_DOUBLE_COLON:: <T_NAME> ::T_DOUBLE_COLON::
  ;

/**
 * Another rule to recognize, like:
 *  - Number()
 *
 *  The rule is pointed at by name: it may well be declared in a grammar that
 *  has not been read yet.
 */
RuleReference -> {
    \assert(\is_array($children));

    $name = $children[0] ?? null;

    \assert($name instanceof \Phplrt\Contracts\Lexer\TokenInterface);
    \assert($name->value !== '', 'The lexer never produces an empty token');

    return new \Phplrt\Compiler\Node\Statement\RuleReference(
        name: $name->value,
        offset: $name->offset,
        length: $name->size,
    );
}
  : <T_NAME> ::T_PARENTHESIS_OPEN:: ::T_PARENTHESIS_CLOSE::
  ;

/**
 * A single thing a sequence is written of, like:
 *  - &<T_ELSE>
 *  - Number()* @error("a number is expected")
 *
 *  A statement may be looked ahead at, and it may be said something about
 *  apart from what it recognizes.
 *
 *  The statement of a predicate is recognized the way any other one is, and
 *  whatever it has read is given back afterwards: an "&" carries on when it
 *  has been recognized, a "!" when it has not, and neither of them ever
 *  reaches the syntax tree.
 *
 *  The predicate stands before the quantifier rather than after it, so
 *  "&Number()*" looks ahead at any number of them at once instead of looking
 *  ahead any number of times.
 *
 *  Whatever is said about the statement is written after the predicate, so it
 *  is said about the looking ahead rather than about what is looked ahead at.
 *
 *  A statement written with nothing around it is that statement.
 */
Element -> {
    \assert(\is_array($children));

    $annotations = [];

    // What is said about the statement is written after it, so it is read off
    // the back until the statement itself is reached
    while (($annotation = $children[\count($children) - 1] ?? null) instanceof \Phplrt\Compiler\Node\Annotation) {
        \array_unshift($annotations, $annotation);

        \array_pop($children);
    }

    $sign = $children[0] ?? null;
    $statement = $children[1] ?? null;

    if ($statement === null) {
        \assert($sign instanceof \Phplrt\Compiler\Node\Statement\Statement);

        $statement = $sign;
    } else {
        \assert($sign instanceof \Phplrt\Contracts\Lexer\TokenInterface);
        \assert($statement instanceof \Phplrt\Compiler\Node\Statement\Statement);

        $statement = new \Phplrt\Compiler\Node\Statement\Predicate(
            statement: $statement,
            isExpected: $sign->value === '&',
            offset: $sign->offset,
            length: \max(0, $statement->offset + $statement->length - $sign->offset),
        );
    }

    if ($annotations === []) {
        return $statement;
    }

    $last = $annotations[\count($annotations) - 1];

    return new \Phplrt\Compiler\Node\Statement\Annotated(
        statement: $statement,
        annotations: $annotations,
        offset: $statement->offset,
        length: \max(0, $last->offset + $last->length - $statement->offset),
    );
}
  : (<T_AMPERSAND> | <T_EXCLAMATION>)? Suffixed() AnnotationList()?
  ;

/**
 * What is said about a rule or about a statement apart from what it
 * recognizes, like:
 *  - @error("a closing parenthesis is expected")
 *
 *  Several of them are written one after another, with nothing in between.
 */
AnnotationList : Annotation()+ ;

/**
 * A single thing said about a rule or about a statement, written as a name
 * along with the values it is said with.
 *
 * What a name means is decided by the compilation rather than here, so a name
 * it knows nothing about is still read.
 */
Annotation -> {
    \assert(\is_array($children));

    $name = \array_shift($children);

    \assert($name instanceof \Phplrt\Lexer\Token\Token);

    // The "@" opening the annotation belongs to the grammar rather than to the
    // name, so the name is captured apart from it
    $identifier = $name->captures[0] ?? '';

    \assert($identifier !== '', 'The name is captured by the token the annotation is read as');

    $arguments = [];
    $last = $name;

    foreach ($children as $argument) {
        \assert($argument instanceof \Phplrt\Contracts\Lexer\TokenInterface);

        // The quotes surrounding a value belong to the grammar rather than to
        // the value, and a quote of the value is written escaped for the very
        // same reason
        $arguments[] = \str_replace('\\"', '"', \substr($argument->value, 1, -1));

        $last = $argument;
    }

    return new \Phplrt\Compiler\Node\Annotation(
        name: $identifier,
        arguments: $arguments,
        offset: $name->offset,
        length: \max(0, $last->offset + $last->size - $name->offset),
    );
}
  : <T_ANNOTATION> ::T_PARENTHESIS_OPEN:: ArgumentList()? ::T_PARENTHESIS_CLOSE::
  ;

ArgumentList : <T_STRING> ArgumentTail()* ;

ArgumentTail : ::T_COMMA:: <T_STRING> ;

Inline
  : InlineValue()
  | InlinePattern()
  ;

/**
 * A token declared by the statement reading it, written as the text it
 * recognizes, like:
 *  - "+"
 *
 *  The text is read as it is written: whatever is special to a regular
 *  expression is only itself here, which is what makes this the shorter way of
 *  spelling the punctuation a language is held together by.
 *
 *  The quotes surrounding it belong to the grammar rather than to the text, and
 *  a quote of the text is written escaped for the very same reason.
 */
InlineValue -> {
    \assert($children instanceof \Phplrt\Lexer\Token\Token);

    return new \Phplrt\Compiler\Node\Statement\InlineValue(
        value: \str_replace('\\"', '"', \substr($children->value, 1, -1)),
        offset: $children->offset,
        length: $children->size,
    );
}
  : <T_STRING>
  ;

/**
 * A token declared by the statement reading it, written as the expression
 * recognizing it, like:
 *  - /and|or|xor/
 *
 *  The slashes surrounding the expression belong to the grammar rather than to
 *  the expression itself, and a slash of the expression is written escaped for
 *  the very same reason.
 */
InlinePattern -> {
    \assert($children instanceof \Phplrt\Lexer\Token\Token);

    return new \Phplrt\Compiler\Node\Statement\InlinePattern(
        pattern: \str_replace('\\/', '/', \substr($children->value, 1, -1)),
        offset: $children->offset,
        length: $children->size,
    );
}
  : <T_REGEX>
  ;
