/**
 * -----------------------------------------------------------------------------
 *  Reducers
 * -----------------------------------------------------------------------------
 */

/**
 * A block of PHP code, like:
 *  - -> { return new SumNode($children); }
 */
CodeReducer -> {
    \assert($children instanceof \Phplrt\Lexer\Token\TokenEmbedding);

    $read = $children->children;
    $code = '';

    // Note: The braces are the first and the last of the tokens read, so
    //       everything between them is the code itself.
    for ($i = 1, $last = \count($read) - 1; $i < $last; ++$i) {
        $code .= $read[$i]->value;
    }

    $lines = \explode("\n", $code);

    // Note: A line starting inside a string literal is a part of its value,
    //       so the spaces it starts with are kept.
    $literal = \Phplrt\Compiler\Internal\PhpStringLiterals::findLiteralLines($code, isFragment: true);

    foreach ($lines as $index => $line) {
        if (isset($literal[$index])) {
            continue;
        }

        $lines[$index] = $index === 0
            ? \ltrim($line)
            : \preg_replace('/^ {1,4}/', '', $line);
    }

    return new \Phplrt\Compiler\Node\Reducer\CodeReducer(
        code: \trim(\implode("\n", $lines)),
        offset: $children->offset,
        length: $children->size,
    );
}
  : <T_PHP>
  ;
