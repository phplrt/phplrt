/**
 * -----------------------------------------------------------------------------
 *  Statements Of The PP2 Format
 * -----------------------------------------------------------------------------
 *
 *  Nothing may be written before a statement in this format, so a statement is
 *  read exactly as it is, and a token a rule declares on the spot is always
 *  written as an expression.
 *
 */

Prefixed : Suffixed() ;

Inline : InlinePattern() ;

/**
 * A token declared by the statement reading it, like:
 *  - "\+"
 *
 *  The quotes surrounding the pattern belong to the grammar rather than to the
 *  pattern itself, and a quote of the pattern is written escaped for the very
 *  same reason.
 */
InlinePattern -> {
    \assert($children instanceof \Phplrt\Lexer\Token\Token);

    return new \Phplrt\Compiler\Node\Statement\InlinePattern(
        pattern: \str_replace('\\"', '"', \substr($children->value, 1, -1)),
        offset: $children->offset,
        length: $children->size,
    );
}
  : <T_STRING>
  ;
