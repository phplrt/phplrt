/**
 * -----------------------------------------------------------------------------
 *  Lexemes Of The PP2 Format
 * -----------------------------------------------------------------------------
 *
 *  Every token a grammar file of this format is read into.
 *
 *  A token is matched in the order it is declared, so the block of PHP code
 *  stands before the arrow opening it.
 *
 *  A token names the state it switches to, a reducer may be written as a class
 *  name, a rule is separated from what it recognizes by any of three spellings,
 *  and a rule may be marked as kept with a "#".
 *
 */

// Trivia

%skip  T_WHITESPACE            \s++
%skip  T_COMMENT               //[^\r\n]*+
%skip  T_DOC                   /\*(.*?)\*/

/**
 * -----------------------------------------------------------------------------
 *  Directives
 * -----------------------------------------------------------------------------
 *
 *  A directive is read as a single token whose subgroups capture its parts.
 *
 *  Which value is which is decided by its position rather than by its content:
 *  a pattern may be spelled exactly like a name and may begin with the two
 *  slashes a comment begins with. A single expression knows every position at
 *  once, which is what tells the values apart.
 *
 */

%token T_PRAGMA                %pragma\h++([a-zA-Z_][a-zA-Z0-9_.]*+)\h++(\S++)
%token T_INCLUDE               %include\h++(\S++)

// A reducer is always written as a block of code, so the arrow of a rule is
// only ever followed by a brace
%token T_PHP                   ->\s*+(?=\{) -> state(php)

// Statements

%token T_SEMICOLON             ;
%token T_OR                    \|
%token T_PARENTHESIS_OPEN      \(
%token T_PARENTHESIS_CLOSE     \)
%token T_ANGLE_OPEN            <
%token T_ANGLE_CLOSE           >

// Quantifiers

%token T_QUESTION_MARK         \?
%token T_PLUS                  \+
%token T_ASTERISK              \*
%token T_BRACE_OPEN            \{
%token T_BRACE_CLOSE           \}
%token T_COMMA                 ,

// Literals

%token T_INT                   \d++
%token T_STRING                "[^"\\]*+(?:\\.[^"\\]*+)*+"
%token T_NAME                  \\?+[a-zA-Z_][a-zA-Z0-9_]*+(?:\\[a-zA-Z_][a-zA-Z0-9_]*+)*+

// A brace written inside a string is only a brace for PHP itself, so the block
// of code is read by a lexer reading PHP the way PHP reads it
%lexer php -> { new \Phplrt\Compiler\Syntax\Common\PhpBlockLexer() }

/**
 * The declaration of a token: the state it belongs to, its name, its pattern
 * and the state it switches to.
 *
 * A declaration is read as a single token whose subgroups capture its parts, so
 * which value is which is decided by its position rather than by its content.
 */
%token T_TOKEN            %token\h++(?:([a-zA-Z_][a-zA-Z0-9_]*+):)?([a-zA-Z_][a-zA-Z0-9_]*+)\h++(\S++)(?:\h++->\h*+(\S++))?
%token T_SKIP             %skip\h++(?:([a-zA-Z_][a-zA-Z0-9_]*+):)?([a-zA-Z_][a-zA-Z0-9_]*+)\h++(\S++)(?:\h++->\h*+(\S++))?

// A reducer written as code is told from a reducer written as a class name by
// the brace, so the arrow alone always opens the latter
%token T_ARROW            ->

// The "::=" separator is spelled with the same colons a skipped token reference
// is surrounded by
%token T_DOUBLE_COLON     ::(?!=)
%token T_EQ               ::=|:|=

%token T_HASH             #
