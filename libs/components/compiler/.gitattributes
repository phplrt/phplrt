* text=auto eol=lf
*.pp eol=lf linguist-language=EBNF
*.pp2 eol=lf linguist-language=EBNF
*.pp3 eol=lf linguist-language=EBNF

# GIT
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore

# Tools
.php-cs-fixer.php export-ignore
phpstan.neon export-ignore

# Tests + CI
phpunit.xml export-ignore

/.github export-ignore
/tests export-ignore

# The script regenerating the parser of a grammar format belongs to the
# monorepo the format is developed in rather than to the released package
/bin export-ignore

# Common
/docs export-ignore
monorepo-builder.yml export-ignore
