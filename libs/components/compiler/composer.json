{
    "name": "phplrt/compiler",
    "type": "library",
    "description": "The phplrt component for compiling a grammar file into a lexer and a parser",
    "license": "MIT",
    "keywords": ["pp2", "grammar", "parser", "lexer", "compiler", "generator"],
    "homepage": "https://github.com/phplrt",
    "support": {
        "issues": "https://github.com/phplrt/phplrt/issues",
        "source": "https://github.com/phplrt/compiler"
    },
    "authors": [
        {
            "name": "Kirill Nesmeyanov",
            "email": "nesk@xakep.ru"
        }
    ],
    "require": {
        "php": "^8.4",
        "laminas/laminas-code": "^4.17",
        "phplrt/exception": "^4.0",
        "phplrt/lexer": "^4.0",
        "phplrt/lexer-builder": "^4.0",
        "phplrt/parser": "^4.0",
        "phplrt/parser-builder": "^4.0",
        "phplrt/source": "^4.0",
        "phplrt/source-contracts": "^4.0",
        "twig/twig": "^3.28"
    },
    "autoload": {
        "psr-4": {
            "Phplrt\\Compiler\\": "src"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5|^13.0",
        "phpstan/phpstan": "^2.1.38",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Phplrt\\Compiler\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev",
            "dev-main": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
