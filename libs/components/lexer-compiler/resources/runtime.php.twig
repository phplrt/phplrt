    /**
     * @var array<non-empty-string, ChannelInterface>
     */
    private array $channels;

    public function __construct()
    {
        $mappings = $channels = [];

        foreach (self::COMPILED_CHANNEL_MAPPING as $aliasName => $channelName) {
            $channels[$channelName] ??= Channel::tryFrom($channelName)
                ?? new class($channelName) implements ChannelInterface {
                    public function __construct(
                        /** @var non-empty-string */
                        public readonly string $value,
                    ) {}
                };

            $mappings[$aliasName] = $channels[$channelName];
        }

        $this->channels = $mappings;
    }

    public function lex(ReadableInterface $source, int $offset = 0): iterable
    {
        \preg_match_all(self::COMPILED_PCRE, $source->content, $matches, offset: $offset);

        /** @var list<non-empty-string> $names */
        $names = $matches['MARK'];
        /** @var list<string> $values */
        $values = $matches[0];

        $result = new \SplFixedArray(\count($names) + 1);

        foreach ($names as $index => $alias) {
            $result[$index] = new {{ token_class | raw }}(
                self::COMPILED_PCRE_ALIAS_MAPPING[$alias],
                $offset,
                $value = $values[$index],
                $this->channels[$alias] ?? null,
            );

            $offset += \strlen($value);
        }

        if ($offset === \strlen($source->content)) {
            $result[$result->count() - 1] = new {{ token_eoi_class | raw }}($offset);
        }

        /** @var iterable<array-key, TokenInterface> */
        return $result;
    }
