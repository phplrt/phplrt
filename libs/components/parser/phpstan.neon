parameters:
  level: max
  fileExtensions:
    - php
  paths:
    - src
  treatPhpDocTypesAsCertain: false
  # PHP 8.3 has no property declarations in an interface, so the buffer states
  # what it exposes using "@property-read". PHPStan reads such a tag only from a
  # type that allows dynamic properties, which is what this entry says.
  universalObjectCratesClasses:
    - Phplrt\Parser\Internal\Buffer\BufferInterface
