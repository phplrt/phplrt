/**
 * -----------------------------------------------------------------------------
 *  Newick Tree Format
 * -----------------------------------------------------------------------------
 *
 * The way a phylogenetic tree is written down: a node is written of the nodes
 * it branches into, its name and the length of the branch reaching it.
 *
 * @see https://evolution.genetics.washington.edu/phylip/newicktree.html
 */

%pragma root Tree

%skip  T_WHITESPACE       \s++

%token T_NUMBER           [0-9]++(?:\.[0-9]++)?
%token T_NAME             [a-zA-Z][a-zA-Z0-9]*+
%token T_PARENTHESIS_OPEN \(
%token T_PARENTHESIS_CLOSE \)
%token T_COMMA            ,
%token T_COLON            :
%token T_SEMICOLON        ;

Tree
  : Branch() ::T_SEMICOLON::
  ;

// A node, and how far it is from the one it branches off
Branch
  : Subtree() Length()
  ;

Subtree
  : Internal()
  | Leaf()
  ;

// (A:1,B:2)Name
Internal
  : ::T_PARENTHESIS_OPEN:: BranchSet() ::T_PARENTHESIS_CLOSE:: Name()
  ;

Leaf
  : Name()
  ;

BranchSet
  : Branch() (::T_COMMA:: Branch())*
  ;

Name
  : <T_NAME>?
  ;

Length
  : (::T_COLON:: <T_NUMBER>)?
  ;
