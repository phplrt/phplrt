/**
 * -----------------------------------------------------------------------------
 *  Statements
 * -----------------------------------------------------------------------------
 *
 *  What a rule recognizes, written one rule per precedence:
 *  - A | B - either of them.
 *  - A B - one after the other.
 *  - A? - how many times it repeats.
 */

Alternation
  : Concatenation() (::T_OR:: Concatenation())*
  ;

Concatenation
  : Suffixed()+
  ;

Suffixed
  : Primary() Quantifier()?
  ;

Primary
  : Group()
  | KeptTokenReference()
  | SkippedTokenReference()
  | RuleReference()
  | Inline()
  ;

// ( A | B )
Group
  : ::T_PARENTHESIS_OPEN:: Alternation() ::T_PARENTHESIS_CLOSE::
  ;

// <T_NAME> - the token is given to the rule
KeptTokenReference
  : ::T_ANGLE_OPEN:: <T_NAME> ::T_ANGLE_CLOSE::
  ;

// ::T_NAME:: - the token is read and dropped
SkippedTokenReference
  : ::T_DOUBLE_COLON:: <T_NAME> ::T_DOUBLE_COLON::
  ;

// Number()
RuleReference
  : <T_NAME> ::T_PARENTHESIS_OPEN:: ::T_PARENTHESIS_CLOSE::
  ;

// A token written where it is used rather than declared: "[0-9]++"
Inline
  : InlinePattern()
  ;

InlinePattern
  : <T_STRING>
  ;
