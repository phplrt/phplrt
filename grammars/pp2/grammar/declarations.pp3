/**
 * -----------------------------------------------------------------------------
 *  Declarations
 * -----------------------------------------------------------------------------
 *
 *  Everything a grammar file is written of: the directives, and the rules of
 *  the parser.
 */

Declaration
  : TokenDeclaration()
  | PragmaDeclaration()
  | IncludeDeclaration()
  | RuleDeclaration()
  ;

// %pragma root Grammar
PragmaDeclaration
  : <T_PRAGMA>
  ;

// %include grammar/lexemes
IncludeDeclaration
  : <T_INCLUDE>
  ;

/**
 * A token to read, like:
 *  - %token T_NAME [a-zA-Z_][a-zA-Z0-9_]*+
 *  - %token string:T_QUOTE " -> default
 *
 *  A token read but never given to the parser is declared with "%skip".
 */
TokenDeclaration
  : <T_TOKEN>
  | <T_SKIP>
  ;

/**
 * A rule of the parser, like:
 *  - #Sum : Number() ;
 *  - Sum -> \App\Ast\SumNode ::= Number() ;
 *  - Sum -> { return new SumNode($children); } = Number() ;
 */
RuleDeclaration
  : KeptMarker()? <T_NAME> Reducer()? ::T_EQ:: Alternation() ::T_SEMICOLON::?
  ;

// The rule is one of those kept by name
KeptMarker
  : <T_HASH>
  ;

Reducer
  : CodeReducer()
  | ClassReducer()
  ;

// -> { ... }
CodeReducer
  : <T_PHP>
  ;

// -> \App\Ast\SumNode
ClassReducer
  : ::T_ARROW:: <T_NAME>
  ;
