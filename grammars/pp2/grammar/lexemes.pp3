/**
 * -----------------------------------------------------------------------------
 *  Lexemes Of The PP2 Format
 * -----------------------------------------------------------------------------
 */

%skip  T_WHITESPACE             \s++
%skip  T_COMMENT                //[^\r\n]*+
%skip  T_DOC                    /\*(.*?)\*/

/**
 * -----------------------------------------------------------------------------
 *  Directives
 * -----------------------------------------------------------------------------
 *
 *  A directive occupies a line of its own and is read as a single token whose
 *  subgroups capture the parts it is written of, like:
 *  - %pragma root Grammar
 *  - %include grammar/lexemes
 *  - %token string:T_QUOTE " -> default
 *  - %skip T_WHITESPACE \s++
 */

%token T_PRAGMA                 %pragma\h++([a-zA-Z_][a-zA-Z0-9_.]*+)\h++(\S++)
%token T_INCLUDE                %include\h++(\S++)
%token T_TOKEN                  %token\h++(?:([a-zA-Z_][a-zA-Z0-9_]*+):)?([a-zA-Z_][a-zA-Z0-9_]*+)\h++(\S++)(?:\h++->\h*+(\S++))?
%token T_SKIP                   %skip\h++(?:([a-zA-Z_][a-zA-Z0-9_]*+):)?([a-zA-Z_][a-zA-Z0-9_]*+)\h++(\S++)(?:\h++->\h*+(\S++))?

/**
 * -----------------------------------------------------------------------------
 *  Reducers
 * -----------------------------------------------------------------------------
 *
 *  A reducer written as a block of PHP code opens with a brace, so the arrow
 *  followed by anything else opens a reducer written as the name of a class.
 *
 *  A brace written inside a string is only a brace for PHP itself, so the
 *  block is read by a lexer reading PHP the way PHP reads it.
 */

%token T_PHP                    ->\s*+(?=\{) -> state(php)
%token T_ARROW                  ->

%lexer php -> { new \Phplrt\Example\Php\PhpBlockLexer() }

/**
 * -----------------------------------------------------------------------------
 *  Statements
 * -----------------------------------------------------------------------------
 *
 *  A rule is separated from what it recognizes by any of three spellings, and
 *  the first of them is spelled with the colons a skipped token reference is
 *  surrounded by.
 */

%token T_SEMICOLON              ;
%token T_OR                     \|
%token T_PARENTHESIS_OPEN       \(
%token T_PARENTHESIS_CLOSE      \)
%token T_ANGLE_OPEN             <
%token T_ANGLE_CLOSE            >
%token T_DOUBLE_COLON           ::(?!=)
%token T_EQ                     ::=|:|=
%token T_HASH                   #

/**
 * -----------------------------------------------------------------------------
 *  Quantifiers
 * -----------------------------------------------------------------------------
 */

%token T_QUESTION_MARK          \?
%token T_PLUS                   \+
%token T_ASTERISK               \*
%token T_BRACE_OPEN             \{
%token T_BRACE_CLOSE            \}
%token T_COMMA                  ,

/**
 * -----------------------------------------------------------------------------
 *  Literals
 * -----------------------------------------------------------------------------
 */

%token T_INT                    \d++
%token T_STRING                 "[^"\\]*+(?:\\.[^"\\]*+)*+"
%token T_NAME                   \\?+[a-zA-Z_][a-zA-Z0-9_]*+(?:\\[a-zA-Z_][a-zA-Z0-9_]*+)*+
