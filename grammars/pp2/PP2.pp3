/**
 * -----------------------------------------------------------------------------
 *  The PP2 Grammar Format
 * -----------------------------------------------------------------------------
 *
 * The format phplrt 3.x read a grammar in, still read by phplrt v4 so that a
 * grammar written back then keeps working.
 *
 * @see https://github.com/phplrt/phplrt/blob/master/libs/components/compiler/resources/pp2.pp3
 */

%include grammar/lexemes        // Token Definitions
%include grammar/declarations   // %pragma, %include, %token, a rule
%include grammar/statements     // What a rule recognizes
%include grammar/quantifiers    // How many times a statement repeats

%pragma root Grammar

/**
 * A grammar file is a list of declarations, each of them written either as a
 * "%" directive or as a rule of the parser.
 */
Grammar
  : Declaration()*
  ;
