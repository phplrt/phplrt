/**
 * What a rule is turned into, and the rules kept by name.
 */

%pragma root Sum

%token T_NUMBER  \d+
%token T_PLUS    \+

// Kept by name, without a reducer of its own
#Sum
  : Number() (::T_PLUS:: Number())*
  ;

// A reducer written as the name of a class
Number -> \App\Ast\NumberNode
  : <T_NUMBER>
  ;

// A reducer written as a block of PHP code, on the line it opens on
Doubled -> { return $children->value * 2; }
  : <T_NUMBER>
  ;

// A block written across several lines, with braces of its own inside it
Checked -> {
    \assert($children instanceof \Phplrt\Lexer\Token\Token);

    $value = $children->value;

    if (!\is_numeric($value)) {
        throw new \InvalidArgumentException('A number is written of digits');
    }

    return (int) $value;
}
  : <T_NUMBER>
  ;

// A brace written inside a string is not a brace of the block
Braces -> {
    $open = '{';
    $close = "}";

    // A brace written inside a comment is not one either: }
    return $open . $close;
}
  : <T_NUMBER>
  ;

// Kept by name, and turned into a node of its own
#Total -> \App\Ast\TotalNode
  : Sum()
  ;
