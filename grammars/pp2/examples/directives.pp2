/**
 * Everything a grammar file declares outside of its rules.
 */

%pragma root Grammar
%pragma lexer.pcre.disable u

%include grammar/lexemes
%include ../shared/common

// Trivia
%skip  T_WHITESPACE     \s+
%skip  T_COMMENT        //[^\n]*

// A token of the default state
%token T_NAME           [a-zA-Z_][a-zA-Z0-9_]*
%token T_NUMBER         \d+(?:\.\d+)?

// A token switching the state, and the tokens of that state
%token T_QUOTE          "               -> string
%token string:T_CHARS   [^"\\]+
%token string:T_ESCAPE  \\.
%token string:T_END     "               -> default
