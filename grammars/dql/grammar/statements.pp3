/**
 * -----------------------------------------------------------------------------
 *  Statements And Their Clauses
 * -----------------------------------------------------------------------------
 */

SelectStatement
  : SelectClause()
    FromClause()
    WhereClause()?
    GroupByClause()?
    HavingClause()?
    OrderByClause()?
  ;

UpdateStatement
  : UpdateClause() WhereClause()?
  ;

DeleteStatement
  : DeleteClause() WhereClause()?
  ;

/**
 * A query reading rows for another query to compare against, like:
 *  - (SELECT MAX(o.total) FROM Demo\Entity\Order o)
 */
SubselectExpression
  : ::T_PARENTHESIS_OPEN:: Subselect() ::T_PARENTHESIS_CLOSE::
  ;

Subselect
  : SimpleSelectClause()
    FromClause()
    WhereClause()?
    GroupByClause()?
    HavingClause()?
    OrderByClause()?
  ;

/**
 * -----------------------------------------------------------------------------
 *  SELECT
 * -----------------------------------------------------------------------------
 */

SelectClause
  : ::T_SELECT:: <T_DISTINCT>?
    SelectExpression() (::T_COMMA:: SelectExpression())*
  ;

SelectExpression
  : ( NewObjectExpression()
    | PartialObjectExpression()
    | SubselectExpression()
    | ScalarExpression()
    )
    ResultVariableDeclaration()?
  ;

SimpleSelectClause
  : ::T_SELECT:: <T_DISTINCT>?
    ( SubselectExpression()
    | ScalarExpression()
    )
    ResultVariableDeclaration()?
  ;

/**
 * The name a selected value is read back under, like:
 *  - AS total
 *  - AS HIDDEN total
 *  - total
 */
ResultVariableDeclaration
  : ::T_AS::? <T_HIDDEN>? Identifier()
  ;

/**
 * Reading a few fields of an entity instead of the whole of it, like:
 *  - PARTIAL u.{id, name}
 */
PartialObjectExpression
  : ::T_PARTIAL:: Identifier() ::T_DOT::
    ::T_BRACE_OPEN::
      Identifier() (::T_COMMA:: Identifier())*
    ::T_BRACE_CLOSE::
  ;

/**
 * Reading the values as an object of a class of its own, like:
 *  - NEW Demo\Dto\UserName(u.first, u.last)
 */
NewObjectExpression
  : ::T_NEW:: AbstractSchemaName()
    ::T_PARENTHESIS_OPEN::
      NewObjectArgument() (::T_COMMA:: NewObjectArgument())*
    ::T_PARENTHESIS_CLOSE::
  ;

NewObjectArgument
  : SubselectExpression()
  | ScalarExpression()
  ;

/**
 * -----------------------------------------------------------------------------
 *  UPDATE And DELETE
 * -----------------------------------------------------------------------------
 */

UpdateClause
  : ::T_UPDATE:: AbstractSchemaName() ::T_AS::? Identifier()?
    ::T_SET:: UpdateItem() (::T_COMMA:: UpdateItem())*
  ;

UpdateItem
  : PathExpression() ::T_EQ:: NewValue()
  ;

NewValue
  : SubselectExpression()
  | ScalarExpression()
  ;

DeleteClause
  : ::T_DELETE:: ::T_FROM::? AbstractSchemaName() ::T_AS::? Identifier()?
  ;

/**
 * -----------------------------------------------------------------------------
 *  FROM
 * -----------------------------------------------------------------------------
 */

FromClause
  : ::T_FROM::
    IdentificationVariableDeclaration()
    (::T_COMMA:: IdentificationVariableDeclaration())*
  ;

IdentificationVariableDeclaration
  : RangeVariableDeclaration() IndexBy()? Join()*
  ;

RangeVariableDeclaration
  : AbstractSchemaName() ::T_AS::? Identifier()
  ;

/**
 * The field the rows are read back under, like:
 *  - INDEX BY u.id
 */
IndexBy
  : ::T_INDEX:: ::T_BY:: PathExpression()
  ;

Join
  : JoinType()? ::T_JOIN::
    ( JoinAssociationDeclaration()
    | RangeVariableDeclaration()
    )
    JoinCondition()?
  ;

JoinType
  : <T_LEFT> <T_OUTER>?
  | <T_INNER>
  ;

JoinAssociationDeclaration
  : PathExpression() ::T_AS::? Identifier() IndexBy()?
  ;

JoinCondition
  : ::T_WITH:: ConditionalExpression()
  ;

/**
 * -----------------------------------------------------------------------------
 *  WHERE, GROUP BY, HAVING And ORDER BY
 * -----------------------------------------------------------------------------
 */

WhereClause
  : ::T_WHERE:: ConditionalExpression()
  ;

HavingClause
  : ::T_HAVING:: ConditionalExpression()
  ;

GroupByClause
  : ::T_GROUP:: ::T_BY:: GroupByItem() (::T_COMMA:: GroupByItem())*
  ;

GroupByItem
  : PathExpression()
  | Identifier()
  ;

OrderByClause
  : ::T_ORDER:: ::T_BY:: OrderByItem() (::T_COMMA:: OrderByItem())*
  ;

OrderByItem
  : ScalarExpression() (<T_ASC> | <T_DESC>)?
  ;
