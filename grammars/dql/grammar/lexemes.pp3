/**
 * -----------------------------------------------------------------------------
 *  Lexemes Of The Doctrine Query Language
 * -----------------------------------------------------------------------------
 *
 *  Every keyword of the language, written in any case, and everything else a
 *  query is written of: the literals, the parameters bound to it, the
 *  operators and the names.
 *
 *  A keyword is reserved and does not name an entity, a field or an alias.
 */

%skip   T_WHITESPACE                    \s++

/**
 * -----------------------------------------------------------------------------
 *  Literals And Parameters
 * -----------------------------------------------------------------------------
 *
 *  A quote inside a string is written twice, the way SQL writes it.
 */

%token  T_STRING                        '(?:[^']|'')*+'
%token  T_FLOAT                         [0-9]++\.[0-9]++(?:[eE][+-]?[0-9]++)?
%token  T_INTEGER                       [0-9]++

%token  T_POSITIONAL_PARAMETER          \?[0-9]++
%token  T_NAMED_PARAMETER               :[a-zA-Z_][a-zA-Z0-9_]*+

/**
 * -----------------------------------------------------------------------------
 *  Statements And Clauses
 * -----------------------------------------------------------------------------
 */

%token  T_SELECT                        (?i)select\b
%token  T_UPDATE                        (?i)update\b
%token  T_DELETE                        (?i)delete\b
%token  T_FROM                          (?i)from\b
%token  T_SET                           (?i)set\b
%token  T_WHERE                         (?i)where\b
%token  T_GROUP                         (?i)group\b
%token  T_HAVING                        (?i)having\b
%token  T_ORDER                         (?i)order\b
%token  T_BY                            (?i)by\b
%token  T_ASC                           (?i)asc\b
%token  T_DESC                          (?i)desc\b

%token  T_JOIN                          (?i)join\b
%token  T_LEFT                          (?i)left\b
%token  T_INNER                         (?i)inner\b
%token  T_OUTER                         (?i)outer\b
%token  T_WITH                          (?i)with\b
%token  T_INDEX                         (?i)index\b

%token  T_AS                            (?i)as\b
%token  T_DISTINCT                      (?i)distinct\b
%token  T_HIDDEN                        (?i)hidden\b
%token  T_PARTIAL                       (?i)partial\b
%token  T_NEW                           (?i)new\b

/**
 * -----------------------------------------------------------------------------
 *  Conditions
 * -----------------------------------------------------------------------------
 */

%token  T_AND                           (?i)and\b
%token  T_OR                            (?i)or\b
%token  T_NOT                           (?i)not\b
%token  T_BETWEEN                       (?i)between\b
%token  T_LIKE                          (?i)like\b
%token  T_ESCAPE                        (?i)escape\b
%token  T_IN                            (?i)in\b
%token  T_IS                            (?i)is\b
%token  T_EMPTY                         (?i)empty\b
%token  T_MEMBER                        (?i)member\b
%token  T_OF                            (?i)of\b
%token  T_EXISTS                        (?i)exists\b
%token  T_INSTANCE                      (?i)instance\b
%token  T_ALL                           (?i)all\b
%token  T_ANY                           (?i)any\b
%token  T_SOME                          (?i)some\b

%token  T_CASE                          (?i)case\b
%token  T_WHEN                          (?i)when\b
%token  T_THEN                          (?i)then\b
%token  T_ELSE                          (?i)else\b
%token  T_END                           (?i)end\b
%token  T_COALESCE                      (?i)coalesce\b
%token  T_NULLIF                        (?i)nullif\b

%token  T_TRUE                          (?i)true\b
%token  T_FALSE                         (?i)false\b
%token  T_NULL                          (?i)null\b

/**
 * -----------------------------------------------------------------------------
 *  Functions
 * -----------------------------------------------------------------------------
 *
 *  The functions reading their arguments alike are read by a token of their
 *  own rather than one token per function: the name a function is called by is
 *  kept as the value of the token.
 */

// AVG(x), COUNT(x), MAX(x), MIN(x), SUM(x)
%token  T_AGGREGATE_FUNCTION            (?i)(?:avg|count|max|min|sum)\b

// CURRENT_DATE, CURRENT_TIME, CURRENT_TIMESTAMP
%token  T_CURRENT_DATETIME_FUNCTION     (?i)current_(?:timestamp|date|time)\b

// DATE_ADD(date, count, unit), DATE_SUB(date, count, unit)
%token  T_DATE_MODIFY_FUNCTION          (?i)date_(?:add|sub)\b

// ABS(x), LENGTH(x), LOWER(x), SQRT(x), UPPER(x)
%token  T_UNARY_FUNCTION                (?i)(?:abs|length|lower|sqrt|upper)\b

// BIT_AND(a, b), BIT_OR(a, b), DATE_DIFF(a, b), MOD(a, b)
%token  T_BINARY_FUNCTION               (?i)(?:bit_and|bit_or|date_diff|mod)\b

%token  T_SIZE                          (?i)size\b
%token  T_LOCATE                        (?i)locate\b
%token  T_CONCAT                        (?i)concat\b
%token  T_SUBSTRING                     (?i)substring\b
%token  T_TRIM                          (?i)trim\b
%token  T_IDENTITY                      (?i)identity\b
%token  T_LEADING                       (?i)leading\b
%token  T_TRAILING                      (?i)trailing\b
%token  T_BOTH                          (?i)both\b

/**
 * -----------------------------------------------------------------------------
 *  Operators And Punctuation
 * -----------------------------------------------------------------------------
 */

%token  T_LTE                           <=
%token  T_GTE                           >=
%token  T_NEQ                           <>|!=
%token  T_EQ                            =
%token  T_LT                            <
%token  T_GT                            >

%token  T_PLUS                          \+
%token  T_MINUS                         \-
%token  T_ASTERISK                      \*
%token  T_SLASH                         /

%token  T_PARENTHESIS_OPEN              \(
%token  T_PARENTHESIS_CLOSE             \)
%token  T_BRACE_OPEN                    \{
%token  T_BRACE_CLOSE                   \}
%token  T_COMMA                         ,
%token  T_DOT                           \.
%token  T_NS_SEPARATOR                  \\

/**
 * -----------------------------------------------------------------------------
 *  Identifier
 * -----------------------------------------------------------------------------
 *
 *  The name of an entity, a field or an alias.
 */

%token  T_IDENTIFIER                    [a-zA-Z_][a-zA-Z0-9_]*+
