/**
 * -----------------------------------------------------------------------------
 *  Names, Paths, Literals And Parameters
 * -----------------------------------------------------------------------------
 */

Identifier
  : <T_IDENTIFIER>
  ;

/**
 * A word written past a separator, where a keyword names a class or a field
 * the same way any other word does, like:
 *  - the "Order" of "Demo\Entity\Order"
 *  - the "order" of "u.order"
 */
NamePart
  : <T_IDENTIFIER>
  | ReservedWord()
  ;

ReservedWord
  : <T_SELECT>
  | <T_UPDATE>
  | <T_DELETE>
  | <T_FROM>
  | <T_SET>
  | <T_WHERE>
  | <T_GROUP>
  | <T_HAVING>
  | <T_ORDER>
  | <T_BY>
  | <T_ASC>
  | <T_DESC>
  | <T_JOIN>
  | <T_LEFT>
  | <T_INNER>
  | <T_OUTER>
  | <T_WITH>
  | <T_INDEX>
  | <T_AS>
  | <T_DISTINCT>
  | <T_HIDDEN>
  | <T_PARTIAL>
  | <T_NEW>
  | <T_AND>
  | <T_OR>
  | <T_NOT>
  | <T_BETWEEN>
  | <T_LIKE>
  | <T_ESCAPE>
  | <T_IN>
  | <T_IS>
  | <T_EMPTY>
  | <T_MEMBER>
  | <T_OF>
  | <T_EXISTS>
  | <T_INSTANCE>
  | <T_ALL>
  | <T_ANY>
  | <T_SOME>
  | <T_CASE>
  | <T_WHEN>
  | <T_THEN>
  | <T_ELSE>
  | <T_END>
  | <T_COALESCE>
  | <T_NULLIF>
  | <T_TRUE>
  | <T_FALSE>
  | <T_NULL>
  | <T_AGGREGATE_FUNCTION>
  | <T_CURRENT_DATETIME_FUNCTION>
  | <T_DATE_MODIFY_FUNCTION>
  | <T_UNARY_FUNCTION>
  | <T_BINARY_FUNCTION>
  | <T_SIZE>
  | <T_LOCATE>
  | <T_CONCAT>
  | <T_SUBSTRING>
  | <T_TRIM>
  | <T_IDENTITY>
  | <T_LEADING>
  | <T_TRAILING>
  | <T_BOTH>
  ;

/**
 * The name an entity is mapped under, like:
 *  - Demo\Entity\User
 *  - \Demo\Entity\User
 *  - User
 */
AbstractSchemaName
  : ::T_NS_SEPARATOR::? Identifier() (::T_NS_SEPARATOR:: NamePart())*
  ;

/**
 * A field read through an alias, like:
 *  - u.name
 *  - u.address.city
 *
 *  A path reading a single value, an association or a collection is written
 *  the same way, so what a path reads is told apart by the mapping rather than
 *  by the syntax.
 */
PathExpression
  : Identifier() (::T_DOT:: NamePart())+
  ;

Literal
  : <T_STRING>
  | <T_FLOAT>
  | <T_INTEGER>
  | <T_TRUE>
  | <T_FALSE>
  | <T_NULL>
  ;

StringLiteral
  : <T_STRING>
  ;

/**
 * A value bound to the query, like:
 *  - ?1
 *  - :name
 */
InputParameter
  : <T_POSITIONAL_PARAMETER>
  | <T_NAMED_PARAMETER>
  ;
