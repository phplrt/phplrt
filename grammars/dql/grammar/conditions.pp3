/**
 * -----------------------------------------------------------------------------
 *  Conditional Expressions
 * -----------------------------------------------------------------------------
 *
 *  What a WHERE, a HAVING and a WITH are written of, one rule per precedence:
 *  - OR - the loosest binding one.
 *  - AND
 *  - NOT
 *  - a single condition, or one surrounded by a pair of parentheses.
 */

ConditionalExpression
  : ConditionalTerm() (::T_OR:: ConditionalTerm())*
  ;

ConditionalTerm
  : ConditionalFactor() (::T_AND:: ConditionalFactor())*
  ;

ConditionalFactor
  : <T_NOT>? ConditionalPrimary()
  ;

// A single condition, or a whole one surrounded by a pair of parentheses
ConditionalPrimary
  : SimpleConditionalExpression()
  | ::T_PARENTHESIS_OPEN:: ConditionalExpression() ::T_PARENTHESIS_CLOSE::
  ;

/**
 * A single condition, like:
 *  - EXISTS (SELECT ...)
 *  - u INSTANCE OF Demo\Entity\Admin
 *  - u.posts IS NOT EMPTY
 *  - u.name IS NULL
 *  - :group MEMBER OF u.groups
 *  - u.age BETWEEN 18 AND 60
 *  - u.name LIKE :pattern
 *  - u.status IN (1, 2)
 *  - u.rating >= 4.5
 */
SimpleConditionalExpression
  : ExistsExpression()
  | InstanceOfExpression()
  | EmptyCollectionComparisonExpression()
  | NullComparisonExpression()
  | CollectionMemberExpression()
  | BetweenExpression()
  | LikeExpression()
  | InExpression()
  | ComparisonExpression()
  ;

ExistsExpression
  : <T_NOT>? ::T_EXISTS:: SubselectExpression()
  ;

// u INSTANCE OF Demo\Entity\Admin, u NOT INSTANCE OF (Demo\Entity\Admin, :type)
InstanceOfExpression
  : Identifier() <T_NOT>? ::T_INSTANCE:: ::T_OF::?
    ( ::T_PARENTHESIS_OPEN::
        InstanceOfParameter() (::T_COMMA:: InstanceOfParameter())*
      ::T_PARENTHESIS_CLOSE::
    | InstanceOfParameter()
    )
  ;

InstanceOfParameter
  : InputParameter()
  | AbstractSchemaName()
  ;

EmptyCollectionComparisonExpression
  : PathExpression() ::T_IS:: <T_NOT>? ::T_EMPTY::
  ;

NullComparisonExpression
  : (InputParameter() | ScalarExpression()) ::T_IS:: <T_NOT>? ::T_NULL::
  ;

CollectionMemberExpression
  : EntityExpression() <T_NOT>? ::T_MEMBER:: ::T_OF::? PathExpression()
  ;

EntityExpression
  : PathExpression()
  | InputParameter()
  | Identifier()
  ;

BetweenExpression
  : ArithmeticExpression() <T_NOT>? ::T_BETWEEN::
    ArithmeticExpression() ::T_AND:: ArithmeticExpression()
  ;

LikeExpression
  : StringExpression() <T_NOT>? ::T_LIKE:: StringPrimary()
    (::T_ESCAPE:: StringLiteral())?
  ;

InExpression
  : ScalarExpression() <T_NOT>? ::T_IN::
    ::T_PARENTHESIS_OPEN::
      ( Subselect()
      | InParameter() (::T_COMMA:: InParameter())*
      )
    ::T_PARENTHESIS_CLOSE::
  ;

InParameter
  : InputParameter()
  | ArithmeticExpression()
  ;

ComparisonExpression
  : ArithmeticExpression() ComparisonOperator()
    (QuantifiedExpression() | ArithmeticExpression())
  ;

ComparisonOperator
  : <T_LTE>
  | <T_GTE>
  | <T_NEQ>
  | <T_EQ>
  | <T_LT>
  | <T_GT>
  ;

QuantifiedExpression
  : (<T_ALL> | <T_ANY> | <T_SOME>) SubselectExpression()
  ;
