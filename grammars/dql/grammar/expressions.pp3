/**
 * -----------------------------------------------------------------------------
 *  Scalar Expressions
 * -----------------------------------------------------------------------------
 *
 *  What a value is written of. The operators are written one rule per
 *  precedence, the same way the conditions are.
 */

ScalarExpression
  : SimpleArithmeticExpression()
  ;

ArithmeticExpression
  : SubselectExpression()
  | SimpleArithmeticExpression()
  ;

SimpleArithmeticExpression
  : ArithmeticTerm() ((<T_PLUS> | <T_MINUS>) ArithmeticTerm())*
  ;

ArithmeticTerm
  : ArithmeticFactor() ((<T_ASTERISK> | <T_SLASH>) ArithmeticFactor())*
  ;

ArithmeticFactor
  : (<T_PLUS> | <T_MINUS>)? ArithmeticPrimary()
  ;

/**
 * A path is read before a bare name, because a name is the beginning of a path
 * and a rule keeps whatever it reads first.
 */
ArithmeticPrimary
  : ::T_PARENTHESIS_OPEN:: SimpleArithmeticExpression() ::T_PARENTHESIS_CLOSE::
  | CaseExpression()
  | AggregateExpression()
  | FunctionDeclaration()
  | Literal()
  | InputParameter()
  | PathExpression()
  | Identifier()
  ;

StringExpression
  : SubselectExpression()
  | StringPrimary()
  ;

StringPrimary
  : StringLiteral()
  | InputParameter()
  | CaseExpression()
  | AggregateExpression()
  | FunctionDeclaration()
  | PathExpression()
  | Identifier()
  ;

/**
 * -----------------------------------------------------------------------------
 *  CASE
 * -----------------------------------------------------------------------------
 *
 *  A case written of conditions is read before a case written of a value,
 *  because a value is never written where the first "WHEN" is.
 */

CaseExpression
  : GeneralCaseExpression()
  | SimpleCaseExpression()
  | CoalesceExpression()
  | NullifExpression()
  ;

GeneralCaseExpression
  : ::T_CASE:: WhenClause()+ ::T_ELSE:: ScalarExpression() ::T_END::
  ;

WhenClause
  : ::T_WHEN:: ConditionalExpression() ::T_THEN:: ScalarExpression()
  ;

SimpleCaseExpression
  : ::T_CASE:: CaseOperand() SimpleWhenClause()+ ::T_ELSE:: ScalarExpression() ::T_END::
  ;

CaseOperand
  : PathExpression()
  ;

SimpleWhenClause
  : ::T_WHEN:: ScalarExpression() ::T_THEN:: ScalarExpression()
  ;

CoalesceExpression
  : ::T_COALESCE::
    ::T_PARENTHESIS_OPEN::
      ScalarExpression() (::T_COMMA:: ScalarExpression())+
    ::T_PARENTHESIS_CLOSE::
  ;

NullifExpression
  : ::T_NULLIF::
    ::T_PARENTHESIS_OPEN::
      ScalarExpression() ::T_COMMA:: ScalarExpression()
    ::T_PARENTHESIS_CLOSE::
  ;
