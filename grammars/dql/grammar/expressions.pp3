/**
 * -----------------------------------------------------------------------------
 *  Scalar Expressions
 * -----------------------------------------------------------------------------
 *
 *  What a value is written of, one rule per precedence:
 *  - "+" and "-" - the loosest binding ones.
 *  - "*" and "/"
 *  - the sign of a single value.
 *  - a path, a literal, a parameter, a function or a whole expression
 *    surrounded by a pair of parentheses.
 */

ScalarExpression
  : SimpleArithmeticExpression()
  ;

ArithmeticExpression
  : SubselectExpression()
  | SimpleArithmeticExpression()
  ;

SimpleArithmeticExpression
  : ArithmeticTerm() ((<T_PLUS> | <T_MINUS>) ArithmeticTerm())*
  ;

ArithmeticTerm
  : ArithmeticFactor() ((<T_ASTERISK> | <T_SLASH>) ArithmeticFactor())*
  ;

ArithmeticFactor
  : (<T_PLUS> | <T_MINUS>)? ArithmeticPrimary()
  ;

ArithmeticPrimary
  : ::T_PARENTHESIS_OPEN:: SimpleArithmeticExpression() ::T_PARENTHESIS_CLOSE::
  | CaseExpression()
  | AggregateExpression()
  | FunctionDeclaration()
  | Literal()
  | InputParameter()
  | PathExpression()
  | Identifier()
  ;

StringExpression
  : SubselectExpression()
  | StringPrimary()
  ;

StringPrimary
  : StringLiteral()
  | InputParameter()
  | CaseExpression()
  | AggregateExpression()
  | FunctionDeclaration()
  | PathExpression()
  | Identifier()
  ;

/**
 * -----------------------------------------------------------------------------
 *  CASE
 * -----------------------------------------------------------------------------
 *
 *  A value told apart by a condition, like:
 *  - CASE WHEN u.rank > 100 THEN 'gold' ELSE 'bronze' END
 *  - CASE u.status WHEN 1 THEN 'active' ELSE 'unknown' END
 *  - COALESCE(u.nickname, u.name)
 *  - NULLIF(u.name, '')
 */

CaseExpression
  : GeneralCaseExpression()
  | SimpleCaseExpression()
  | CoalesceExpression()
  | NullifExpression()
  ;

GeneralCaseExpression
  : ::T_CASE:: WhenClause()+ ::T_ELSE:: ScalarExpression() ::T_END::
  ;

WhenClause
  : ::T_WHEN:: ConditionalExpression() ::T_THEN:: ScalarExpression()
  ;

SimpleCaseExpression
  : ::T_CASE:: CaseOperand() SimpleWhenClause()+ ::T_ELSE:: ScalarExpression() ::T_END::
  ;

CaseOperand
  : PathExpression()
  ;

SimpleWhenClause
  : ::T_WHEN:: ScalarExpression() ::T_THEN:: ScalarExpression()
  ;

CoalesceExpression
  : ::T_COALESCE::
    ::T_PARENTHESIS_OPEN::
      ScalarExpression() (::T_COMMA:: ScalarExpression())+
    ::T_PARENTHESIS_CLOSE::
  ;

NullifExpression
  : ::T_NULLIF::
    ::T_PARENTHESIS_OPEN::
      ScalarExpression() ::T_COMMA:: ScalarExpression()
    ::T_PARENTHESIS_CLOSE::
  ;
