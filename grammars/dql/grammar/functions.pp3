/**
 * -----------------------------------------------------------------------------
 *  Functions
 * -----------------------------------------------------------------------------
 *
 *  The aggregates and the functions of the language, grouped by the arguments
 *  each of them reads. The name a function is called by is kept as the value
 *  of its token.
 */

AggregateExpression
  : <T_AGGREGATE_FUNCTION>
    ::T_PARENTHESIS_OPEN::
      <T_DISTINCT>? SimpleArithmeticExpression()
    ::T_PARENTHESIS_CLOSE::
  ;

FunctionDeclaration
  : CurrentDateTimeFunction()
  | UnaryFunction()
  | BinaryFunction()
  | DateModifyFunction()
  | SizeFunction()
  | LocateFunction()
  | ConcatFunction()
  | SubstringFunction()
  | TrimFunction()
  | IdentityFunction()
  ;

// CURRENT_DATE, CURRENT_TIME, CURRENT_TIMESTAMP
CurrentDateTimeFunction
  : <T_CURRENT_DATETIME_FUNCTION>
  ;

// ABS(x), LENGTH(x), LOWER(x), SQRT(x), UPPER(x)
UnaryFunction
  : <T_UNARY_FUNCTION>
    ::T_PARENTHESIS_OPEN:: ScalarExpression() ::T_PARENTHESIS_CLOSE::
  ;

// BIT_AND(a, b), BIT_OR(a, b), DATE_DIFF(a, b), MOD(a, b)
BinaryFunction
  : <T_BINARY_FUNCTION>
    ::T_PARENTHESIS_OPEN::
      ScalarExpression() ::T_COMMA:: ScalarExpression()
    ::T_PARENTHESIS_CLOSE::
  ;

// DATE_ADD(date, count, unit), DATE_SUB(date, count, unit)
DateModifyFunction
  : <T_DATE_MODIFY_FUNCTION>
    ::T_PARENTHESIS_OPEN::
      ScalarExpression() ::T_COMMA:: ScalarExpression() ::T_COMMA:: Identifier()
    ::T_PARENTHESIS_CLOSE::
  ;

// SIZE(u.phones)
SizeFunction
  : ::T_SIZE::
    ::T_PARENTHESIS_OPEN:: PathExpression() ::T_PARENTHESIS_CLOSE::
  ;

// LOCATE(needle, haystack), LOCATE(needle, haystack, offset)
LocateFunction
  : ::T_LOCATE::
    ::T_PARENTHESIS_OPEN::
      ScalarExpression() ::T_COMMA:: ScalarExpression()
      (::T_COMMA:: ScalarExpression())?
    ::T_PARENTHESIS_CLOSE::
  ;

// CONCAT(a, b, ...)
ConcatFunction
  : ::T_CONCAT::
    ::T_PARENTHESIS_OPEN::
      ScalarExpression() (::T_COMMA:: ScalarExpression())+
    ::T_PARENTHESIS_CLOSE::
  ;

// SUBSTRING(string, from), SUBSTRING(string, from, length)
SubstringFunction
  : ::T_SUBSTRING::
    ::T_PARENTHESIS_OPEN::
      ScalarExpression() ::T_COMMA:: ScalarExpression()
      (::T_COMMA:: ScalarExpression())?
    ::T_PARENTHESIS_CLOSE::
  ;

// TRIM(string), TRIM(BOTH ' ' FROM string)
TrimFunction
  : ::T_TRIM::
    ::T_PARENTHESIS_OPEN::
      TrimSpecification()? StringPrimary()
    ::T_PARENTHESIS_CLOSE::
  ;

TrimSpecification
  : (<T_LEADING> | <T_TRAILING> | <T_BOTH>)? StringLiteral()? ::T_FROM::
  ;

// IDENTITY(u.address), IDENTITY(u.address, 'id')
IdentityFunction
  : ::T_IDENTITY::
    ::T_PARENTHESIS_OPEN::
      PathExpression() (::T_COMMA:: StringLiteral())?
    ::T_PARENTHESIS_CLOSE::
  ;
