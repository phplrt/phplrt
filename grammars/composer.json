{
    "name": "phplrt/grammars",
    "description": "An example phplrt PP2/PP3 grammars for several languages",
    "version": "4.0.0",
    "type": "project",
    "license": "MIT",
    "keywords": ["pp3", "grammar", "example", "source", "peg"],
    "homepage": "https://github.com/phplrt",
    "support": {
        "issues": "https://github.com/phplrt/phplrt/issues",
        "source": "https://github.com/phplrt/grammars"
    },
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "Phplrt\\Example\\": "src"
        }
    },
    "authors": [
        {
            "name": "Kirill Nesmeyanov",
            "email": "nesk@xakep.ru"
        }
    ],
    "require-dev": {
        "phplrt/compiler": "^4.0",
        "phpunit/phpunit": "^12.5|^13.0",
        "phpstan/phpstan": "^2.2"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev",
            "dev-main": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
