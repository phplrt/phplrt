/**
 * Everything a grammar file declares outside of its rules.
 */

%pragma root Grammar
%pragma lexer.pcre.flag u
%pragma lexer.pcre.disable i

%include grammar/lexemes
%include ../shared/common

// Trivia
%skip  T_WHITESPACE     \s++
%skip  T_COMMENT        //[^\r\n]*+
%skip  *:T_ANY_STATE    \h++

// A token of the default state
%token T_NAME           [a-zA-Z_][a-zA-Z0-9_]*+
%token T_NUMBER         \d++(?:\.\d++)?

// A token opening a state of its own, and the tokens of that state
%token T_QUOTE          "   -> state(string)
%token string:T_CHARS   [^"\\]++
%token string:T_ESCAPE  \\.
%token string:T_END     "   -> exit()

// Several actions at once
%token T_COMMENT_OPEN   /\*  -> state(comment), channel(trivia)

// A lexer written by hand
%lexer php -> { new \App\Lexer\PhpBlockLexer() }
