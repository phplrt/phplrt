/**
 * How many times a statement repeats.
 */

%pragma root List

List
  : Optional()
  | OneOrMore()
  | ZeroOrMore()
  | Ranges()
  ;

Optional
  : <T_SIGN>? <T_NUMBER>
  ;

OneOrMore
  : <T_NUMBER>+
  ;

ZeroOrMore
  : <T_NUMBER>*
  ;

Ranges
  : <T_NUMBER>{4}
  | <T_NUMBER>{2,}
  | <T_NUMBER>{,8}
  | <T_NUMBER>{2,8}
  ;

// A quantifier written on a group, and on a rule
Nested
  : (<T_NUMBER> ::T_COMMA::)*
  | (Optional() | OneOrMore())+
  | Ranges(){1,3}
  | ("," /[0-9]++/)?
  ;
