/**
 * Everything a rule may recognize.
 */

%pragma root Expression

// Either of them
Expression
  : Sum()
  | Product()
  | Terminal()
  ;

// One after the other, with a group in the middle
Sum
  : Product() (::T_PLUS:: Product())
  ;

// A token given to the rule, and a token read and dropped
Product
  : <T_NUMBER> ::T_ASTERISK:: <T_NUMBER>
  ;

// A token written where it is used rather than declared
Terminal
  : "true"
  | "false"
  | /[0-9]++/
  | /[a-z]++(?:_[a-z]++)*+/
  ;

// Look ahead for it, and look ahead for anything but it
Guarded
  : &<T_NAME> Expression()
  | !<T_NAME> Terminal()
  ;

// A rule written without the closing semicolon
Bare
  : Expression()

// A name written in full
Qualified
  : \App\Node\Sum()
  ;

// Nesting, and a rule written on a single line
Nested : ((Sum() | Product()) (::T_COMMA:: (Sum() | Product()))) ;
