/**
 * -----------------------------------------------------------------------------
 *  Lexemes Of The PP3 Format
 * -----------------------------------------------------------------------------
 */

%skip  T_WHITESPACE             \s++
%skip  T_COMMENT                //[^\r\n]*+
%skip  T_DOC                    /\*(.*?)\*/

/**
 * -----------------------------------------------------------------------------
 *  Directives
 * -----------------------------------------------------------------------------
 *
 *  A directive occupies a line of its own and is read as a single token whose
 *  subgroups capture the parts it is written of, like:
 *  - %pragma root Grammar
 *  - %include grammar/lexemes
 *  - %token string:T_QUOTE " -> state(string), channel(strings)
 *  - %skip *:T_WHITESPACE \s++
 *  - %lexer php
 */

%token T_PRAGMA                 %pragma\h++([a-zA-Z_][a-zA-Z0-9_.]*+)\h++(\S++)
%token T_INCLUDE                %include\h++(\S++)
%token T_TOKEN                  %token\h++(?:([a-zA-Z_][a-zA-Z0-9_]*+|\*):)?([a-zA-Z_][a-zA-Z0-9_]*+)\h++(\S++)(?:\h++(->[^\r\n]*+))?
%token T_SKIP                   %skip\h++(?:([a-zA-Z_][a-zA-Z0-9_]*+|\*):)?([a-zA-Z_][a-zA-Z0-9_]*+)\h++(\S++)(?:\h++(->[^\r\n]*+))?
%token T_LEXER                  %lexer\h++([a-zA-Z_][a-zA-Z0-9_]*+)

/**
 * -----------------------------------------------------------------------------
 *  Reducer
 * -----------------------------------------------------------------------------
 *
 *  A reducer is always written as a block of PHP code, so the arrow of a rule
 *  is only ever followed by a brace.
 *
 *  A brace written inside a string is only a brace for PHP itself, so the
 *  block is read by a lexer reading PHP the way PHP reads it.
 */

%token T_PHP                    ->\s*+(?=\{) -> state(php)

%lexer php -> { new \Phplrt\Example\Php\PhpBlockLexer() }

/**
 * -----------------------------------------------------------------------------
 *  Statements
 * -----------------------------------------------------------------------------
 */

%token T_SEMICOLON              ;
%token T_OR                     \|
%token T_PARENTHESIS_OPEN       \(
%token T_PARENTHESIS_CLOSE      \)
%token T_ANGLE_OPEN             <
%token T_ANGLE_CLOSE            >
%token T_DOUBLE_COLON           ::
%token T_COLON                  :
%token T_AMPERSAND              &
%token T_EXCLAMATION            !

/**
 * -----------------------------------------------------------------------------
 *  Quantifiers
 * -----------------------------------------------------------------------------
 */

%token T_QUESTION_MARK          \?
%token T_PLUS                   \+
%token T_ASTERISK               \*
%token T_BRACE_OPEN             \{
%token T_BRACE_CLOSE            \}
%token T_COMMA                  ,

/**
 * -----------------------------------------------------------------------------
 *  Literals
 * -----------------------------------------------------------------------------
 *
 *  A pattern written inline is surrounded by a pair of slashes, and a comment
 *  opens with a pair of them, so the comments are read first.
 */

%token T_INT                    \d++
%token T_STRING                 "[^"\\]*+(?:\\.[^"\\]*+)*+"
%token T_REGEX                  /([^/\\]*+(?:\\.[^/\\]*+)*+)/
%token T_NAME                   \\?+[a-zA-Z_][a-zA-Z0-9_]*+(?:\\[a-zA-Z_][a-zA-Z0-9_]*+)*+
