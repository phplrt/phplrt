/**
 * -----------------------------------------------------------------------------
 *  Quantifiers
 * -----------------------------------------------------------------------------
 *
 *  How many times a statement repeats, like:
 *  - A? - none or one.
 *  - A+ - one or more.
 *  - A* - none or more.
 *  - A{2,5}, A{2,}, A{,5}, A{2} - as many times as written.
 */

Quantifier
  : ZeroOrOne()
  | OneOrMore()
  | ZeroOrMore()
  | Range()
  ;

ZeroOrOne
  : <T_QUESTION_MARK>
  ;

OneOrMore
  : <T_PLUS>
  ;

ZeroOrMore
  : <T_ASTERISK>
  ;

Range
  : ::T_BRACE_OPEN:: RangeBody() ::T_BRACE_CLOSE::
  ;

RangeBody
  : RangeFromTo()
  | RangeFrom()
  | RangeTo()
  | RangeExactly()
  ;

RangeFromTo
  : <T_INT> ::T_COMMA:: <T_INT>
  ;

RangeFrom
  : <T_INT> ::T_COMMA::
  ;

RangeTo
  : ::T_COMMA:: <T_INT>
  ;

RangeExactly
  : <T_INT>
  ;
