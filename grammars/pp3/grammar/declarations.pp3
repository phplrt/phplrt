/**
 * -----------------------------------------------------------------------------
 *  Declarations
 * -----------------------------------------------------------------------------
 *
 *  Everything a grammar file is written of: the directives, and the rules of
 *  the parser.
 */

Declaration
  : TokenDeclaration()
  | PragmaDeclaration()
  | IncludeDeclaration()
  | LexerDeclaration()
  | RuleDeclaration()
  ;

// %pragma root Grammar
PragmaDeclaration
  : <T_PRAGMA>
  ;

// %include grammar/lexemes
IncludeDeclaration
  : <T_INCLUDE>
  ;

/**
 * A token to read, like:
 *  - %token T_NAME [a-zA-Z_][a-zA-Z0-9_]*+
 *  - %token string:T_QUOTE " -> state(string), channel(strings)
 *
 *  A token read but never given to the parser is declared with "%skip".
 */
TokenDeclaration
  : <T_TOKEN>
  | <T_SKIP>
  ;

// %lexer php -> { new \App\Lexer\PhpLexer() }
LexerDeclaration
  : <T_LEXER> CodeReducer()
  ;

/**
 * A rule of the parser, written of its name, what it is turned into and what
 * it recognizes, like:
 *  - Sum -> { return new SumNode($children); } : Number() ;
 */
RuleDeclaration
  : <T_NAME> CodeReducer()? ::T_COLON:: Alternation() ::T_SEMICOLON::?
  ;

// -> { ... }
CodeReducer
  : <T_PHP>
  ;
