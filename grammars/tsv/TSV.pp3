/**
 * -----------------------------------------------------------------------------
 *  Tab-Separated Values
 * -----------------------------------------------------------------------------
 *
 * A line break separates the rows and a tab separates the fields, so neither is
 * trivia and nothing is skipped: every character of the file is data.
 *
 * @see https://www.iana.org/assignments/media-types/text/tab-separated-values
 */

%pragma root File

// A quote written inside a quoted field is written twice
%token T_STRING  "(?:""|[^"])*+"
%token T_TEXT    [^\t\r\n"]++
%token T_TAB     \t
%token T_EOL     \r?+\n

File
  : Row()+
  ;

Row
  : Field()? (::T_TAB:: Field()?)* ::T_EOL::
  ;

Field
  : <T_STRING>
  | <T_TEXT>
  ;
