/**
 * -----------------------------------------------------------------------------
 *  PSR-5 Type Expression
 * -----------------------------------------------------------------------------
 *
 * The type language of PSR-5 (PHPDoc).
 *
 * @see https://github.com/php-fig/fig-standards/blob/master/proposed/phpdoc.md
 */

// A label is written of octets, so "\x7f-\xff" names every byte a label
// outside ASCII is written of
%pragma lexer.pcre.disable u

%pragma root TypeExpression

/**
 * -----------------------------------------------------------------------------
 *  Lexemes
 * -----------------------------------------------------------------------------
 */

%skip   T_WHITESPACE            \s++

// $this
%token  T_THIS                  \$this(?![a-zA-Z0-9\x7f-\xff])

// The words naming a type of the language itself
%token  T_ARRAY                 (?i)array(?![a-zA-Z0-9\x7f-\xff])
%token  T_BOOL                  (?i)bool(?![a-zA-Z0-9\x7f-\xff])
%token  T_CALLABLE              (?i)callable(?![a-zA-Z0-9\x7f-\xff])
%token  T_FALSE                 (?i)false(?![a-zA-Z0-9\x7f-\xff])
%token  T_FLOAT                 (?i)float(?![a-zA-Z0-9\x7f-\xff])
%token  T_INT                   (?i)int(?![a-zA-Z0-9\x7f-\xff])
%token  T_ITERABLE              (?i)iterable(?![a-zA-Z0-9\x7f-\xff])
%token  T_MIXED                 (?i)mixed(?![a-zA-Z0-9\x7f-\xff])
%token  T_NEVER                 (?i)never(?![a-zA-Z0-9\x7f-\xff])
%token  T_NULL                  (?i)null(?![a-zA-Z0-9\x7f-\xff])
%token  T_OBJECT                (?i)object(?![a-zA-Z0-9\x7f-\xff])
%token  T_RESOURCE              (?i)resource(?![a-zA-Z0-9\x7f-\xff])
%token  T_SELF                  (?i)self(?![a-zA-Z0-9\x7f-\xff])
%token  T_STATIC                (?i)static(?![a-zA-Z0-9\x7f-\xff])
%token  T_STRING                (?i)string(?![a-zA-Z0-9\x7f-\xff])
%token  T_TRUE                  (?i)true(?![a-zA-Z0-9\x7f-\xff])
%token  T_VOID                  (?i)void(?![a-zA-Z0-9\x7f-\xff])

// A single part of a class name: letters and digits, and no digit first
%token  T_LABEL                 [a-zA-Z\x7f-\xff][a-zA-Z0-9\x7f-\xff]*+

%token  T_NS_DELIMITER          \\
%token  T_PIPE                  \|
%token  T_AMPERSAND             &
%token  T_PARENTHESIS_OPEN      \(
%token  T_PARENTHESIS_CLOSE     \)
%token  T_SQUARE_BRACKET_OPEN   \[
%token  T_SQUARE_BRACKET_CLOSE  \]

/**
 * -----------------------------------------------------------------------------
 *  Type Expression
 * -----------------------------------------------------------------------------
 *
 *  The types a value may be, like:
 *  - int|string|null - for a value of either type.
 *  - Countable&Traversable - for a value of every type at once.
 *
 *  The union is written before the intersection.
 */

TypeExpression
  : Type()
    (::T_PIPE:: Type())*
    (::T_AMPERSAND:: Type())*
  ;

/**
 * A single type, with "[]" written past it for an array of it, like:
 *  - int
 *  - Demo\Entity\User
 *  - int[][]
 *  - (int|string)[]
 */
Type
  : ArrayExpression() ArraySuffix()+
  | NonArrayType() ArraySuffix()*
  ;

// (int|string)
ArrayExpression
  : ::T_PARENTHESIS_OPEN:: TypeExpression() ::T_PARENTHESIS_CLOSE::
  ;

// []
ArraySuffix
  : ::T_SQUARE_BRACKET_OPEN:: ::T_SQUARE_BRACKET_CLOSE::
  ;

NonArrayType
  : ClassName()
  | Keyword()
  ;

/**
 * The name of a class, written of one label or of several, like:
 *  - MyClass
 *  - \Demo\Entity\User
 *  - array\Item - a keyword names a class as much as a label does
 */
ClassName
  : ::T_NS_DELIMITER:: Label() (::T_NS_DELIMITER:: Label())*
  | Label() (::T_NS_DELIMITER:: Label())+
  | <T_LABEL>
  ;

Label
  : <T_LABEL>
  | KeywordLabel()
  ;

Keyword
  : <T_THIS>
  | KeywordLabel()
  ;

// Every keyword but "$this", each of them spelled the way a label is
KeywordLabel
  : <T_ARRAY>
  | <T_BOOL>
  | <T_CALLABLE>
  | <T_FALSE>
  | <T_FLOAT>
  | <T_INT>
  | <T_ITERABLE>
  | <T_MIXED>
  | <T_NEVER>
  | <T_NULL>
  | <T_OBJECT>
  | <T_RESOURCE>
  | <T_SELF>
  | <T_STATIC>
  | <T_STRING>
  | <T_TRUE>
  | <T_VOID>
  ;
