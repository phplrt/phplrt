/**
 * -----------------------------------------------------------------------------
 *  Statements And Their Clauses
 * -----------------------------------------------------------------------------
 */

SelectStatement
  : SelectClause()
    WhereClause()?
    GroupClause()?
    HavingClause()?
    OrderClause()?
    SelectLimitClause()?
    ForUpdateClause()?
  ;

SelectClause
  : ::T_SELECT:: DistinctAll()? ColumnList()
    ::T_FROM:: AssociatedNameList() Join()*
  ;

DistinctAll
  : <T_DISTINCT>
  | <T_ALL>
  ;

ColumnList
  : ColumnItem() (::T_COMMA:: ColumnItem())*
  ;

// u.*, u.name AS title, COUNT(u.id) total
ColumnItem
  : QualifiedName() ::T_DOT:: ::T_TIMES::
  | ::T_TIMES::
  | Expression() (::T_AS::? Identifier())?
  ;

/**
 * -----------------------------------------------------------------------------
 *  FROM And JOIN
 * -----------------------------------------------------------------------------
 */

AssociatedNameList
  : AssociatedName() (::T_COMMA:: AssociatedName())*
  ;

AssociatedName
  : QualifiedName() (::T_AS::? Identifier())?
  ;

Join
  : JoinType()? ::T_JOIN:: AssociatedName() JoinConditions()?
  ;

JoinType
  : <T_INNER>
  | <T_CROSS>
  | (<T_LEFT> | <T_RIGHT> | <T_FULL>) <T_OUTER>?
  ;

JoinConditions
  : ::T_ON:: Expression()
  ;

/**
 * -----------------------------------------------------------------------------
 *  INSERT, UPDATE And DELETE
 * -----------------------------------------------------------------------------
 */

InsertStatement
  : ::T_INSERT:: ::T_INTO:: AssociatedName()
    (::T_PARENTHESES_OPEN:: FieldList() ::T_PARENTHESES_CLOSE::)?
    ::T_VALUES:: ::T_PARENTHESES_OPEN:: ValuesList() ::T_PARENTHESES_CLOSE::
  ;

FieldList
  : Identifier() (::T_COMMA:: Identifier())*
  ;

ValuesList
  : Expression() (::T_COMMA:: Expression())*
  ;

UpdateStatement
  : ::T_UPDATE:: AssociatedName() ::T_SET:: UpdateItemList()
    WhereClause()? LimitClause()?
  ;

UpdateItemList
  : UpdateItem() (::T_COMMA:: UpdateItem())*
  ;

UpdateItem
  : QualifiedName() ::T_EQUALS:: Expression()
  ;

DeleteStatement
  : ::T_DELETE:: ::T_FROM:: AssociatedName() WhereClause()? LimitClause()?
  ;

/**
 * -----------------------------------------------------------------------------
 *  WHERE, GROUP BY, HAVING, ORDER BY And LIMIT
 * -----------------------------------------------------------------------------
 */

WhereClause
  : ::T_WHERE:: Expression()
  ;

GroupClause
  : ::T_GROUP:: ::T_BY:: GroupItem() (::T_COMMA:: GroupItem())*
  ;

GroupItem
  : Expression()
  ;

HavingClause
  : ::T_HAVING:: Expression()
  ;

OrderClause
  : ::T_ORDER:: ::T_BY:: OrderItem() (::T_COMMA:: OrderItem())*
  ;

OrderItem
  : Expression() (<T_ASC> | <T_DESC>)?
  ;

// LIMIT 10, LIMIT 10, 20, LIMIT 10 OFFSET 20
SelectLimitClause
  : ::T_LIMIT:: IntegerOrPlaceholder()
    ( ::T_COMMA:: IntegerOrPlaceholder()
    | ::T_OFFSET:: IntegerOrPlaceholder()
    )?
  ;

LimitClause
  : ::T_LIMIT:: IntegerOrPlaceholder()
  ;

IntegerOrPlaceholder
  : <T_INTEGER>
  | Placeholder()
  ;

ForUpdateClause
  : ::T_FOR:: ::T_UPDATE::
  ;
