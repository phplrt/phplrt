/**
 * -----------------------------------------------------------------------------
 *  Lexemes Of The Phalcon Query Language
 * -----------------------------------------------------------------------------
 *
 *  Every keyword of the language, written in any case, and everything else a
 *  query is written of: the literals, the placeholders bound to it, the
 *  operators and the names.
 *
 *  A keyword is reserved and does not name a model, a field or an alias.
 */

%skip   T_WHITESPACE            \s++
%skip   T_COMMENT               --[^\r\n]*+|/\*.*?\*/

/**
 * -----------------------------------------------------------------------------
 *  Literals And Placeholders
 * -----------------------------------------------------------------------------
 *
 *  A value bound to the query is written by its number, by its name, or by the
 *  colon the name follows.
 */

%token  T_STRING                '(?:[^']|'')*+'|"(?:[^"]|"")*+"
%token  T_DOUBLE                [0-9]++\.[0-9]++(?:[eE][+\-]?[0-9]++)?
%token  T_HINTEGER              0[xX][0-9a-fA-F]++
%token  T_INTEGER               [0-9]++

%token  T_NPLACEHOLDER          \?[0-9]++
%token  T_SPLACEHOLDER          :[a-zA-Z_][a-zA-Z0-9_]*+:
%token  T_BPLACEHOLDER          \{[a-zA-Z_][a-zA-Z0-9_]*+(?::[^}]++)?\}

/**
 * -----------------------------------------------------------------------------
 *  Statements And Clauses
 * -----------------------------------------------------------------------------
 */

%token  T_SELECT                (?i)select\b
%token  T_INSERT                (?i)insert\b
%token  T_UPDATE                (?i)update\b
%token  T_DELETE                (?i)delete\b
%token  T_INTO                  (?i)into\b
%token  T_VALUES                (?i)values\b
%token  T_SET                   (?i)set\b
%token  T_FROM                  (?i)from\b
%token  T_WHERE                 (?i)where\b
%token  T_GROUP                 (?i)group\b
%token  T_HAVING                (?i)having\b
%token  T_ORDER                 (?i)order\b
%token  T_BY                    (?i)by\b
%token  T_LIMIT                 (?i)limit\b
%token  T_OFFSET                (?i)offset\b
%token  T_FOR                   (?i)for\b
%token  T_ASC                   (?i)asc\b
%token  T_DESC                  (?i)desc\b
%token  T_DISTINCT              (?i)distinct\b
%token  T_ALL                   (?i)all\b
%token  T_AS                    (?i)as\b

%token  T_JOIN                  (?i)join\b
%token  T_INNER                 (?i)inner\b
%token  T_CROSS                 (?i)cross\b
%token  T_LEFT                  (?i)left\b
%token  T_RIGHT                 (?i)right\b
%token  T_FULL                  (?i)full\b
%token  T_OUTER                 (?i)outer\b
%token  T_ON                    (?i)on\b

/**
 * -----------------------------------------------------------------------------
 *  Operators Written As Words
 * -----------------------------------------------------------------------------
 */

%token  T_BETWEEN_NOT           (?i)not\h++between\b
%token  T_BETWEEN               (?i)between\b
%token  T_AND                   (?i)and\b
%token  T_OR                    (?i)or\b
%token  T_NOT                   (?i)not\b
%token  T_LIKE                  (?i)like\b
%token  T_ILIKE                 (?i)ilike\b
%token  T_IN                    (?i)in\b
%token  T_EXISTS                (?i)exists\b
%token  T_IS                    (?i)is\b
%token  T_NULL                  (?i)null\b
%token  T_TRUE                  (?i)true\b
%token  T_FALSE                 (?i)false\b
%token  T_AGAINST               (?i)against\b

%token  T_CASE                  (?i)case\b
%token  T_WHEN                  (?i)when\b
%token  T_THEN                  (?i)then\b
%token  T_ELSE                  (?i)else\b
%token  T_END                   (?i)end\b
%token  T_CAST                  (?i)cast\b
%token  T_CONVERT               (?i)convert\b
%token  T_USING                 (?i)using\b

/**
 * -----------------------------------------------------------------------------
 *  Operators Written As Signs
 * -----------------------------------------------------------------------------
 *
 *  An operator written of several characters is declared before the one
 *  written of its first, so "->>" is not read as "->" followed by ">".
 */

%token  T_OP_JSON_GET_TEXT      ->>
%token  T_OP_JSON_GET           ->
%token  T_OP_JSON_PATH_TEXT     #>>
%token  T_OP_JSON_PATH          #>
%token  T_OP_CONTAINS           @>
%token  T_OP_CONTAINED          <@
%token  T_OP_MATCHES            @@
%token  T_OP_OVERLAPS           &&
%token  T_OP_CONCAT             \|\|

%token  T_GREATEREQUAL          >=
%token  T_LESSEQUAL             <=
%token  T_NOTEQUALS             <>|!=
%token  T_EQUALS                =
%token  T_GREATER               >
%token  T_LESS                  <

%token  T_PLUS                  \+
%token  T_MINUS                 -
%token  T_TIMES                 \*
%token  T_DIVIDE                /
%token  T_MOD                   %

%token  T_BITWISE_AND           &
%token  T_BITWISE_OR            \|
%token  T_BITWISE_XOR           \^
%token  T_BITWISE_NOT           ~

%token  T_PARENTHESES_OPEN      \(
%token  T_PARENTHESES_CLOSE     \)
%token  T_COMMA                 ,
%token  T_DOT                   \.
%token  T_COLON                 :

/**
 * -----------------------------------------------------------------------------
 *  Identifier
 * -----------------------------------------------------------------------------
 *
 *  The name of a model, a field or an alias, written plainly or surrounded by
 *  a pair of brackets.
 */

%token  T_IDENTIFIER            \[[^\]]++\]|[a-zA-Z_][a-zA-Z0-9_]*+(?:\\[a-zA-Z_][a-zA-Z0-9_]*+)*+
