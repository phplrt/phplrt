/**
 * -----------------------------------------------------------------------------
 *  Phalcon Query Language
 * -----------------------------------------------------------------------------
 *
 * The query language of the Phalcon ORM: a query written of models and their
 * fields rather than of tables and their columns.
 *
 * @see https://github.com/phalcon/phql/blob/master/c/parser.php.lemon
 */

%include grammar/lexemes        // Token Definitions
%include grammar/statements     // SELECT, INSERT, UPDATE, DELETE
%include grammar/expressions    // Values, Operators And Calls

%pragma root QueryLanguage

QueryLanguage
  : SelectStatement()
  | InsertStatement()
  | UpdateStatement()
  | DeleteStatement()
  ;
