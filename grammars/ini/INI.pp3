/**
 * -----------------------------------------------------------------------------
 *  INI
 * -----------------------------------------------------------------------------
 *
 * The configuration format "parse_ini_file()" reads: sections, keys and the
 * values assigned to them.
 *
 * @see https://www.php.net/manual/en/function.parse-ini-file.php
 */

%pragma root File

/**
 * -----------------------------------------------------------------------------
 *  Lexemes
 * -----------------------------------------------------------------------------
 *
 *  A line break ends a value, so it is not skipped along with the rest of the
 *  whitespace. A comment ends where the line does and is dropped whole.
 */

%skip  T_HORIZONTAL_SPACE   \h++
%skip  T_COMMENT            [;#][^\r\n]*+

%token T_NEWLINE            \R

%token T_BRACKET_OPEN       \[
%token T_BRACKET_CLOSE      \]
%token T_EQUAL              =

// A value written across several lines escapes the break closing it
%token T_STRING             "(?:[^"\\]|\\[\s\S])*+"|'(?:[^'\\]|\\[\s\S])*+'

// A key is written of everything but what surrounds it
%token T_KEY                [^\s\[\]=;#]++

// A bare value ends where the line does, and carries no comment of its own
%token T_VALUE              [^\r\n;#]++

File
  : (Section() | Entry() | ::T_NEWLINE::)*
  ;

// [database]
Section
  : ::T_BRACKET_OPEN:: SectionName() ::T_BRACKET_CLOSE:: ::T_NEWLINE::?
  ;

SectionName
  : <T_KEY>
  | <T_STRING>
  ;

// host = localhost
Entry
  : Key() ::T_EQUAL:: Value()? ::T_NEWLINE::?
  ;

// A key written with brackets appends to an array: "hosts[] = a"
Key
  : <T_KEY> (::T_BRACKET_OPEN:: <T_KEY>? ::T_BRACKET_CLOSE::)?
  ;

Value
  : <T_STRING>
  | <T_VALUE>
  ;
