%skip  T_WHITESPACE     \s++

%token T_STRING         "(?:[^"\\]|\\.)*+"
%token T_NUMBER         -?\d++(?:\.\d++)?(?:[eE][+-]?\d++)?
%token T_TRUE           true
%token T_FALSE          false
%token T_NULL           null

%token T_BRACE_OPEN     \{
%token T_BRACE_CLOSE    \}
%token T_BRACKET_OPEN   \[
%token T_BRACKET_CLOSE  \]
%token T_COLON          :
%token T_COMMA          ,

%pragma root Value

Value
  : Object()
  | Array()
  | String()
  | Number()
  | True()
  | False()
  | Null()
  ;

Object
  : ::T_BRACE_OPEN::
      (Member() (::T_COMMA:: Member())*)?
    ::T_BRACE_CLOSE::
  ;

Member
  : String() ::T_COLON:: Value()
  ;

Array
  : ::T_BRACKET_OPEN::
      (Value() (::T_COMMA:: Value())*)?
    ::T_BRACKET_CLOSE::
  ;

String
  : <T_STRING>
  ;

Number
  : <T_NUMBER>
  ;

True
  : <T_TRUE>
  ;

False
  : <T_FALSE>
  ;

Null
  : <T_NULL>
  ;
