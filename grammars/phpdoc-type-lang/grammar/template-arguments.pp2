
TemplateArguments
  : ::T_ANGLE_BRACKET_OPEN::
      TemplateArgument() (
        ::T_COMMA:: TemplateArgument()
      )* ::T_COMMA::?
    ::T_ANGLE_BRACKET_CLOSE::
  ;

TemplateArgument
  : TemplateHintedArgument()
  | TemplateSimpleArgument()
  ;

TemplateSimpleArgument
  : Type()
  ;

TemplateHintedArgument
  : IdentifierWithExtraSpace() Type()
  ;
