
Name
  : FullQualifiedName()
  | RelativeName()
  ;

FullQualifiedName
  : ::T_NS_DELIMITER:: Identifier() (::T_NS_DELIMITER:: Identifier())*
  ;

RelativeName
  : Identifier() (::T_NS_DELIMITER:: Identifier())*
  ;

Identifier
  : <T_NAME>
  | <T_NAME_WITH_SPACE>
  | <T_EQ>
  | <T_BOOL_LITERAL>
  | <T_NULL_LITERAL>
  ;

IdentifierWithExtraSpace
    : <T_NAME_WITH_SPACE>
    ;
