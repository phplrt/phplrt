/**
 * -----------------------------------------------------------------------------
 *  Hoa PP
 * -----------------------------------------------------------------------------
 *
 * The grammar description format of Hoa\Compiler
 *
 * @see https://github.com/hoaproject/Compiler/blob/master/Llk/Llk.pp
 */

%pragma root Grammar

/**
 * -----------------------------------------------------------------------------
 *  Lexemes Of The File
 * -----------------------------------------------------------------------------
 *
 *  A directive, a comment and the name of a rule each occupy a line of their
 *  own and begin it, while everything a rule recognizes is written indented
 *  under its name. Each of them is therefore anchored to the beginning of a
 *  line, and whatever is written past an indent is not one of them.
 */

%skip  T_COMMENT              ^//[^\r\n]*+
%skip  T_WHITESPACE           \s++

%token T_PRAGMA               ^%pragma\h++(\S++)\h++([^\r\n]*+)
%token T_SKIP                 ^%skip\h++(?:([^\h:]++):)?(\S++)\h++([^\r\n]*+)
%token T_TOKEN                ^%token\h++(?:([^\h:]++):)?(\S++)\h++([^\r\n]*?)(?:\h++->\h++([^\r\n]*+))?$

// The name a rule is written under, kept by name when written with a "#"
%token T_RULE_NAME            ^#?[a-zA-Z_][a-zA-Z0-9_]*+:

/**
 * -----------------------------------------------------------------------------
 *  Lexemes Of A Rule
 * -----------------------------------------------------------------------------
 */

%token T_OR                   \|

%token T_N_TO_M               \{[0-9]++,[0-9]++\}
%token T_ZERO_TO_M            \{,[0-9]++\}
%token T_N_OR_MORE            \{[0-9]++,\}
%token T_EXACTLY_N            \{[0-9]++\}
%token T_ZERO_OR_ONE          \?
%token T_ONE_OR_MORE          \+
%token T_ZERO_OR_MORE         \*

%token T_SKIPPED              ::
%token T_KEPT_OPEN            <
%token T_KEPT_CLOSE           >

// The parentheses of a rule reference, read before the ones of a group
%token T_NAMED                \(\)
%token T_CAPTURING_OPEN       \(
%token T_CAPTURING_CLOSE      \)

%token T_NODE                 #[a-zA-Z_][a-zA-Z0-9_]*+(?::[mM])?

%token T_UNIFICATION_OPEN     \[
%token T_UNIFICATION          [0-9]++
%token T_UNIFICATION_CLOSE    \]

%token T_NAME                 [a-zA-Z_][a-zA-Z0-9_]*+

/**
 * -----------------------------------------------------------------------------
 *  Grammar
 * -----------------------------------------------------------------------------
 */

Grammar
  : Declaration()*
  ;

Declaration
  : PragmaDeclaration()
  | TokenDeclaration()
  | RuleDeclaration()
  ;

// %pragma lexer.unicode true
PragmaDeclaration
  : <T_PRAGMA>
  ;

/**
 * A token to read, like:
 *  - %token number (0|[1-9]\d*)
 *  - %token string:quote " -> default
 *  - %skip space [\x20\x09]+
 */
TokenDeclaration
  : <T_TOKEN>
  | <T_SKIP>
  ;

// The name of a rule, and everything written indented under it
RuleDeclaration
  : <T_RULE_NAME> Choice()
  ;

/**
 * -----------------------------------------------------------------------------
 *  Statements
 * -----------------------------------------------------------------------------
 */

Choice
  : Concatenation() (::T_OR:: Concatenation())*
  ;

Concatenation
  : Repetition()+
  ;

Repetition
  : Simple() Quantifier()? <T_NODE>?
  ;

Simple
  : ::T_CAPTURING_OPEN:: Choice() ::T_CAPTURING_CLOSE::
  | ::T_SKIPPED:: <T_NAME> Unification()? ::T_SKIPPED::
  | ::T_KEPT_OPEN:: <T_NAME> Unification()? ::T_KEPT_CLOSE::
  | <T_NAME> ::T_NAMED::
  ;

// The number tying two references of the same token together: <token[0]>
Unification
  : ::T_UNIFICATION_OPEN:: <T_UNIFICATION> ::T_UNIFICATION_CLOSE::
  ;

Quantifier
  : <T_ZERO_OR_ONE>
  | <T_ONE_OR_MORE>
  | <T_ZERO_OR_MORE>
  | <T_N_TO_M>
  | <T_ZERO_TO_M>
  | <T_N_OR_MORE>
  | <T_EXACTLY_N>
  ;
